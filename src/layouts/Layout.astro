---
import "../styles/global.css";
import { contact, gtmConfig } from "../data/media";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = "/img/banner.webp", noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Gazzotto BBQ",
  description:
    "Churrasco à parrilla com atendimento personalizado para eventos corporativos, casamentos, aniversários e confraternizações.",
  url: Astro.site?.href ?? "https://gazzotto.com.br",
  image: ogImage,
  telephone: contact.whatsapp ? `+${contact.whatsapp}` : undefined,
  sameAs: [contact.instagram, contact.facebook].filter((s) => s && s !== "#"),
  areaServed: "BR",
  servesCuisine: "Churrasco, Parrilla",
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    {gtmConfig.containerId && (
      <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmConfig.containerId}');`} />
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#25272c" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Gazzotto BBQ" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {gtmConfig.containerId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmConfig.containerId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}
    <slot />
    {contact.whatsapp && (
      <a
        class="wa-float"
        href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent("Olá! Quero um orçamento com a Gazzotto BBQ.")}`}
        target="_blank"
        rel="noopener"
        aria-label="Falar com a Gazzotto BBQ pelo WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>
        <span class="wa-float__tip">Fale conosco</span>
      </a>
    )}
    <script is:inline>
      // O botão flutuante do WhatsApp fica fixo no canto da tela (coordenadas da janela visível,
      // não da página) -- com o teclado do celular aberto, a área visível encolhe e ele pode
      // acabar bem em cima do próximo campo do formulário que a pessoa tenta tocar (ex.: depois
      // de preencher a Data, ao tentar tocar em Cidade logo abaixo), bloqueando o toque mesmo sem
      // nada aparecer de errado na tela. Por isso ele some sempre que algum campo de formulário
      // estiver em foco (teclado provavelmente aberto) e volta assim que o foco sai.
      (function () {
        var waFloat = document.querySelector(".wa-float");
        if (!waFloat) return;
        function ehCampo(el) {
          return !!el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT");
        }
        document.addEventListener("focusin", function (e) { if (ehCampo(e.target)) waFloat.classList.add("wa-float--oculto"); });
        document.addEventListener("focusout", function (e) { if (ehCampo(e.target)) waFloat.classList.remove("wa-float--oculto"); });

        // O botão "Continuar" do configurador "Monte seu Evento" também fica no canto
        // inferior direito, bem perto de onde o botão do WhatsApp flutua -- em telas de
        // celular os dois acabam vizinhos (às vezes quase encostando), e um toque mirado no
        // "Continuar" pode acabar pegando o botão do WhatsApp em vez de avançar a etapa. Por
        // isso o botão do WhatsApp some por completo sempre que a seção do configurador está
        // visível na tela, voltando só quando a pessoa rola pra longe dela.
        var wizSection = document.getElementById("monte-seu-evento");
        if (wizSection && "IntersectionObserver" in window) {
          new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              waFloat.classList.toggle("wa-float--oculto-wiz", entry.isIntersecting);
            });
          }, { threshold: 0 }).observe(wizSection);
        }
      })();
    </script>
    <CookieConsent />
  </body>
</html>
