---
/**
 * Etapa "Não é só burger": vídeo controlado pelo scroll (frame a frame, reversível, suavizado por rAF)
 * com o título aparecendo palavra a palavra.
 * Vídeo local em public/video/burger.mp4 (trocado a pedido do cliente; antes vinha do Cloudinary).
 */
const VIDEO = "/video/burger.mp4";
---
<section class="sv" data-scrubvideo aria-labelledby="sv-title">
  <div class="sv__stage">
    <video class="sv__video" src={VIDEO} muted playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video>
    <div class="sv__copy">
      <div>
        <h2 class="sv__title" id="sv-title"><span>Não é só burger.</span> <span class="sv__accent">É parte do evento.</span></h2>
      </div>
    </div>
  </div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="sv-smoke" x="-25%" y="-50%" width="150%" height="200%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.02" numOctaves="2" seed="11" result="noise" />
      <feDisplacementMap id="sv-smoke-map" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</section>
<noscript><style>.sv { height: 100vh; } .sv__stage { position: relative; top: 0; }</style></noscript>

<style is:global>
.sv {
  position: relative; height: 260vh;
  /* "borda infinita" com o Cardápio: o vídeo entra 10% por baixo dessa seção anterior
     (que cobre esse trecho, graças ao z-index dela). Já com o Momentos, a transição fica
     encostada mas com borda reta (sem degradê/blur) — o palco vermelho começa numa linha
     limpa, a pedido do cliente. */
  margin-top: -10vh;
  background: var(--bg-dark, #0f1214);
}
.sv__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: var(--bg-dark, #0f1214);
  /* bordas "infinitas": o vídeo se dissolve no fundo da página em cima e embaixo (mesma cor da seção, sem gradiente/sombra) */
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%); }
.sv__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; background: #000; }
/* "cover" em todas as telas: o vídeo preenche 100% da altura do palco (sem tarjas/letterbox em
   cima ou embaixo). Era "contain" no desktop por causa do vídeo antigo (proporção mais "quadrada",
   que cortava o hambúrguer com "cover"); o vídeo atual (1920x1080) preenche bem com "cover". */
.sv__copy { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; padding: 0 1rem; pointer-events: none; }
.sv__title { font: 500 clamp(1.15rem, 3.4vw, 2.2rem)/1.25 var(--font-display, "Oswald", sans-serif); letter-spacing: .05em; color: #fff; text-align: center; white-space: normal; text-wrap: balance; will-change: filter, opacity, transform; }
@media (min-width: 700px) { .sv__title { white-space: nowrap; } }
.sv__title .sv__accent { color: inherit; }
/* Celular: o scroll do vídeo dura mais */
@media (max-width: 768px) { .sv { height: 420vh; } }
@media (prefers-reduced-motion: reduce) { .sv { height: 100vh; } .sv__stage { position: relative; top: 0; } }
</style>

<script>
(function () {
var svs = Array.prototype.slice.call(document.querySelectorAll("[data-scrubvideo]"));
if (svs.length) {
  var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  var LERP = 0.14, EPS = 0.001, MIN = 0.55;

  svs.forEach(function (sec) {
    var video = sec.querySelector("video"), title = sec.querySelector(".sv__title");
    var smokeMap = document.getElementById("sv-smoke-map");
    if (reduced) { video.pause(); return; }
    var dur = 0, target = 0, cur = 0, raf = 0, top = 0, range = 1, near = false, primed = false, lastP = -1;

    var measure = function () { top = sec.getBoundingClientRect().top + scrollY; range = Math.max(1, sec.offsetHeight - innerHeight); };
    var onMeta = function () { if (video.readyState >= 1 && isFinite(video.duration)) { dur = video.duration; compute(); } };
    var prime = function () { if (primed) return; primed = true; var p = video.play(); if (p && p.then) p.then(function () { video.pause(); }).catch(function () {}); };
    var kick = function () { if (!raf) raf = requestAnimationFrame(tick); };

    // Título: começa em fumaça (blur + distorção via turbulência) e se resolve em texto nítido
    // ao longo do início da rolagem da seção — igual ao efeito do banner, mas em vez de dissolver
    // o texto (nítido → fumaça), aqui ele nasce da fumaça (fumaça → nítido).
    var paintTitle = function (p) {
      var tp = Math.min(Math.max((p - 0.04) / 0.5, 0), 1);
      if (tp >= 1) { title.style.opacity = ""; title.style.filter = ""; title.style.transform = ""; return; }
      if (tp <= 0) {
        title.style.opacity = String(MIN);
        title.style.filter = "url(#sv-smoke) blur(22px)";
        if (smokeMap) smokeMap.setAttribute("scale", "160");
        title.style.transform = "scale(1.1)";
        return;
      }
      var e = Math.pow(1 - tp, 1.3);
      title.style.opacity = (MIN + (1 - MIN) * tp).toFixed(3);
      title.style.filter = "url(#sv-smoke) blur(" + (22 * e).toFixed(1) + "px)";
      if (smokeMap) smokeMap.setAttribute("scale", String(Math.round(160 * e)));
      title.style.transform = "scale(" + (1 + 0.1 * e).toFixed(3) + ")";
    };

    var compute = function () {
      var y = Math.min(Math.max(scrollY - top, 0), range), p = y / range;
      if (p !== lastP) { lastP = p; paintTitle(p); }
      target = dur * p;
      if (dur) kick();
    };
    var tick = function () {
      raf = 0;
      var d = target - cur;
      if (Math.abs(d) < EPS) cur = target;
      else { cur += d * LERP; if (Math.abs(target - cur) < 0.008) cur = target; }
      if (!video.seeking && Math.abs(video.currentTime - cur) > EPS) video.currentTime = cur >= dur - 0.008 ? dur : cur;
      if (Math.abs(target - cur) > EPS || video.seeking) kick();
    };

    paintTitle(0);
    video.addEventListener("loadedmetadata", onMeta, { once: true });
    // Só carrega o vídeo pesado quando a seção está a ~2 telas de distância.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        near = es[0].isIntersecting;
        if (near) { video.preload = "auto"; prime(); measure(); compute(); }
      }, { rootMargin: "200% 0px" }).observe(sec);
    } else { video.preload = "auto"; near = true; }
    addEventListener("scroll", function () { if (near) compute(); }, { passive: true });
    addEventListener("resize", function () { measure(); lastP = -1; compute(); }, { passive: true });
    addEventListener("load", function () { measure(); compute(); });
    measure(); onMeta();
  });
}

})();
</script>
