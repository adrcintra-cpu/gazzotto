@media (max-width: 1024px) { .wiz__exp-cards { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .wiz__exp-cards { grid-template-columns: 1fr; } }

/* Etapa 2 */
.wiz__cat { margin-bottom: 1.8rem; }
.wiz__cat-title { font: 700 .85rem var(--font-body); text-transform: uppercase; letter-spacing: .04em; color: var(--chicken); margin-bottom: .7rem; }
.wiz__chips { display: flex; flex-wrap: wrap; gap: .6rem; }
.wiz__chip { display: flex; flex-direction: column; text-align: left; gap: .15rem; padding: .55rem .9rem; border-radius: 8px; border: 1px solid var(--line); background: var(--card); color: var(--text); cursor: pointer; font: 600 .82rem var(--font-body); transition: border-color .2s, background .2s; }
.wiz__chip small { font-weight: 400; font-size: .68rem; color: var(--muted); max-width: 22ch; }
.wiz__chip:hover { border-color: var(--chicken); }
