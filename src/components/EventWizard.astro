---
/**
 * EventWizard — "Monte seu Evento": configurador de orçamento embutido na home, logo após a
 * seção de Cardápios. Wizard de 5 etapas (experiência → personalização → dados do evento →
 * revisão → confirmação), gravando direto no Supabase (RLS cuida da segurança: o cliente só
 * consegue criar orçamentos novos, nunca ler os de terceiros).
 *
 * Entrada em cena: título/tagline/etapas e os 3 cartões da Etapa 1 sobem com fade ao entrar na
 * tela (mesmo padrão de .moments__head em MomentsGallery.astro). Sem JS / com "reduzir
 * movimento": tudo já visível, sem transição.
 */
import Icon from "./Icon.astro";
import { contact, supabaseConfig } from "../data/media";
---
<section class="wiz" id="monte-seu-evento" aria-labelledby="wiz-title">
  <div class="wrap wiz__head" data-reveal>
    <h2 class="h2" id="wiz-title">Monte seu Evento</h2>
    <p class="wiz__tagline">Seu evento, seu cardápio, uma experiência inesquecível.</p>

    <ol class="wiz__steps" data-steps aria-label="Etapas do pedido de orçamento">
      <li data-dot="1"><span class="wiz__step-num">1</span><span class="wiz__step-label">Experiência</span></li>
      <li data-dot="2"><span class="wiz__step-num">2</span><span class="wiz__step-label">Personalize</span></li>
      <li data-dot="3"><span class="wiz__step-num">3</span><span class="wiz__step-label">Seu evento</span></li>
      <li data-dot="4"><span class="wiz__step-num">4</span><span class="wiz__step-label">Revisão</span></li>
      <li data-dot="5"><span class="wiz__step-num">5</span><span class="wiz__step-label">Confirmação</span></li>
    </ol>
  </div>

  <div class="wrap wiz__body">
    <!-- ETAPA 1 — Escolha sua experiência -->
    <div class="wiz__panel" data-panel="1">
      <h3 class="wiz__panel-title">Escolha sua experiência</h3>
      <div class="wiz__exp-cards" data-reveal>
        <button type="button" class="wiz__exp-card" data-modalidade="pacote">
          <span class="wiz__exp-icon"><Icon name="trophy" size={30} /></span>
          <h4>Cardápios Gazzotto</h4>
          <p>Escolha um cardápio pronto, já pensado pela nossa equipe.</p>
        </button>
        <button type="button" class="wiz__exp-card" data-modalidade="monte_cardapio">
          <span class="wiz__exp-icon"><Icon name="cut" size={30} /></span>
          <h4>Monte seu Cardápio</h4>
          <p>Escolha cortes, acompanhamentos e sobremesas do seu jeito.</p>
        </button>
        <button type="button" class="wiz__exp-card" data-modalidade="festival_hamburguer">
          <span class="wiz__exp-icon"><Icon name="flame" size={30} /></span>
          <h4>Festival de Hambúrguer</h4>
          <p>Hambúrgueres artesanais na brasa para o seu evento.</p>
        </button>
      </div>
    </div>

    <!-- ETAPA 2 — Personalize seu evento -->
    <div class="wiz__panel" data-panel="2" hidden>
      <h3 class="wiz__panel-title" data-step2-title>Personalize seu evento</h3>
      <div data-step2-content class="wiz__step2-content" aria-live="polite">
        <p class="wiz__loading">Carregando opções…</p>
      </div>
      <div class="wiz__nav">
        <button type="button" class="wiz__btn-back" data-back>Voltar</button>
        <button type="button" class="btn btn--red" data-next>Continuar</button>
      </div>
    </div>

    <!-- ETAPA 3 — Informações do evento -->
    <div class="wiz__panel" data-panel="3" hidden>
      <h3 class="wiz__panel-title">Informações do evento</h3>
      <form class="wiz__form" data-form-evento novalidate>
        <fieldset class="wiz__fgroup">
          <legend>Responsável</legend>
          <label class="wiz__field">
            <span>Nome completo *</span>
            <input type="text" name="nome_responsavel" required autocomplete="name" />
          </label>
          <label class="wiz__field">
            <span>WhatsApp *</span>
            <input type="tel" name="whatsapp" required placeholder="(19) 99999-9999" autocomplete="tel" />
          </label>
          <label class="wiz__field">
            <span>E-mail</span>
            <input type="email" name="email" autocomplete="email" />
          </label>
        </fieldset>

        <fieldset class="wiz__fgroup">
          <legend>Evento</legend>
          <label class="wiz__field">
            <span>Tipo de evento *</span>
            <select name="tipo_evento" required>
              <option value="" disabled selected>Selecione</option>
              <option>Casamento</option>
              <option>Aniversário</option>
              <option>Confraternização</option>
              <option>Evento corporativo</option>
              <option>Outro</option>
            </select>
          </label>
          <label class="wiz__field">
            <span>Data *</span>
            <input type="date" name="data_evento" required data-data-evento />
          </label>
          <label class="wiz__field">
            <span>Horário de início</span>
            <input type="time" name="horario_inicio" />
          </label>
          <label class="wiz__field">
            <span>Endereço ou local</span>
            <input type="text" name="endereco" />
          </label>
          <label class="wiz__field">
            <span>Cidade</span>
            <input type="text" name="cidade" />
          </label>
        </fieldset>

        <fieldset class="wiz__fgroup">
          <legend>Convidados</legend>
          <label class="wiz__field">
            <span>Quantidade de adultos *</span>
            <input type="number" name="qtd_adultos" min="1" step="1" required />
          </label>
          <label class="wiz__field">
            <span>Quantidade de crianças</span>
            <input type="number" name="qtd_criancas" min="0" step="1" value="0" data-qtd-criancas />
          </label>
          <label class="wiz__field" data-idades-criancas hidden>
            <span>Idades das crianças</span>
            <input type="text" name="idades_criancas" placeholder="ex.: 4, 7 e 10 anos" />
          </label>
          <label class="wiz__field">
            <span>Equipe de apoio / fornecedores que precisam de alimentação</span>
            <input type="number" name="qtd_equipe_apoio" min="0" step="1" value="0" />
          </label>
        </fieldset>

        <fieldset class="wiz__fgroup">
          <legend>Estrutura</legend>
          <div class="wiz__field wiz__field--full">
            <span>Onde será preparado o churrasco? *</span>
            <div class="wiz__radios">
              <label><input type="radio" name="estrutura_churrasco" value="parrilla_gazzotto" required /> Parrilla da Gazzotto</label>
              <label><input type="radio" name="estrutura_churrasco" value="churrasqueira_local" /> Churrasqueira disponível no local</label>
            </div>
          </div>
          <div class="wiz__field wiz__field--full">
            <span>Deseja contratar buffet? *</span>
            <div class="wiz__radios">
              <label><input type="radio" name="deseja_buffet" value="sim" required data-buffet-radio /> Sim</label>
              <label><input type="radio" name="deseja_buffet" value="nao" data-buffet-radio /> Não</label>
            </div>
          </div>
          <div class="wiz__field wiz__field--full" data-louca-field hidden>
            <span>Pratos e talheres *</span>
            <div class="wiz__radios">
              <label><input type="radio" name="tipo_louca" value="descartaveis" /> Descartáveis</label>
              <label><input type="radio" name="tipo_louca" value="porcelana" /> Louças de porcelana e talheres de inox</label>
            </div>
          </div>
        </fieldset>

        <fieldset class="wiz__fgroup">
          <legend>Observações</legend>
          <label class="wiz__field wiz__field--full">
            <span>Necessidades especiais, restrições alimentares ou outras solicitações</span>
            <textarea name="observacoes" rows="3"></textarea>
          </label>
        </fieldset>
      </form>
      <div class="wiz__nav">
        <button type="button" class="wiz__btn-back" data-back>Voltar</button>
        <button type="button" class="btn btn--red" data-next>Continuar</button>
      </div>
    </div>

    <!-- ETAPA 4 — Revisão -->
    <div class="wiz__panel" data-panel="4" hidden>
      <h3 class="wiz__panel-title">Revise seu pedido</h3>
      <div class="wiz__resumo" data-resumo></div>
      <p class="wiz__aviso">O valor final do seu evento será calculado pela nossa equipe. Após o envio, você recebe um protocolo e pode falar direto com a Gazzotto pelo WhatsApp.</p>
      <div class="wiz__nav">
        <button type="button" class="wiz__btn-back" data-back>Voltar</button>
        <button type="button" class="btn btn--red" data-enviar>Confirmar e enviar</button>
      </div>
      <p class="wiz__erro" data-erro-envio hidden role="alert"></p>
    </div>

    <!-- ETAPA 5 — Confirmação -->
    <div class="wiz__panel" data-panel="5" hidden>
      <div class="wiz__confirmacao" data-confirmacao></div>
    </div>
  </div>
</section>

<script type="module" define:vars={{ SUPABASE_URL: supabaseConfig.url, SUPABASE_KEY: supabaseConfig.publishableKey, WHATSAPP: contact.whatsapp }}>
  import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

  // IMPORTANTE: nunca encadear `.select()` depois de `.insert()` nas tabelas `orcamentos` /
  // `orcamento_itens` — elas não têm política de SELECT para o cliente anônimo (de propósito,
  // ninguém além da equipe deve ler orçamentos de terceiros), e o RETURNING do insert também
  // é filtrado por política de SELECT. Sem `.select()`, o insert funciona normalmente; com
  // `.select()`, o Postgres recusa a linha inteira com "new row violates row-level security
  // policy" mesmo quando os dados são válidos. Testado e confirmado no banco em 2026-11-14.
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  const CATEGORIA_LABELS = {
    cortes_bovinos: "Cortes bovinos",
    cortes_suinos: "Cortes suínos",
    cortes_aves: "Cortes de aves",
    cortes_cordeiro: "Cortes de cordeiro",
    acompanhamentos_especiais: "Acompanhamentos especiais",
    sobremesas: "Sobremesas",
    adicionais_brasa: "Adicionais especiais — Feitos na Brasa (opcional)",
    festival_burgers: "Escolha os hambúrgueres",
    festival_acompanhamentos: "Acompanhamentos",
    festival_sobremesas: "Sobremesa",
  };
  // Categorias de escolha única (radio) — as demais são seleção múltipla (chips).
  const RADIO_CATEGORIAS = new Set(["festival_sobremesas"]);
  const MODALIDADE_LABELS = {
    pacote: "Cardápios Gazzotto",
    monte_cardapio: "Monte seu Cardápio",
    festival_hamburguer: "Festival de Hambúrguer",
  };
  const ESTRUTURA_LABELS = { parrilla_gazzotto: "Parrilla da Gazzotto", churrasqueira_local: "Churrasqueira disponível no local" };
  const LOUCA_LABELS = { descartaveis: "Descartáveis", porcelana: "Louças de porcelana e talheres de inox" };

  const wizRoot = document.getElementById("monte-seu-evento");

  const state = {
    modalidade: null,
    pacoteId: null,
    selections: {
      monte_cardapio: new Set(),
      adicionais: new Set(),
      festival_burgers: new Set(),
      festival_acompanhamentos: new Set(),
      festival_sobremesas: new Set(),
    },
    evento: {},
  };

  let catalogo = null; // preenchido por carregarCatalogo()
  let itensPorId = new Map();
  let isSubmitting = false;

  async function carregarCatalogo() {
    if (catalogo) return catalogo;
    const [{ data: categorias, error: e1 }, { data: itens, error: e2 }, { data: pacotes, error: e3 }] = await Promise.all([
      supabase.from("categorias").select("id, grupo, slug, nome, ordem").order("ordem"),
      supabase.from("itens").select("id, categoria_id, nome, descricao, ordem").order("ordem"),
      supabase.from("pacotes").select("id, nome, descricao").order("ordem"),
    ]);
    if (e1 || e2 || e3) throw e1 || e2 || e3;
    itensPorId = new Map(itens.map((i) => [i.id, i]));
    catalogo = { categorias, itens, pacotes };
    return catalogo;
  }

  function itensDaCategoria(categoriaId) {
    return catalogo.itens.filter((i) => i.categoria_id === categoriaId);
  }

  // ---------- Navegação entre etapas ----------
  const panels = Array.from(wizRoot.querySelectorAll("[data-panel]"));
  const dots = Array.from(wizRoot.querySelectorAll("[data-dot]"));
  let currentStep = 1;

  function goToStep(n) {
    currentStep = n;
    panels.forEach((p) => { p.hidden = Number(p.dataset.panel) !== n; });
    dots.forEach((d) => {
      const i = Number(d.dataset.dot);
      d.classList.toggle("is-active", i === n);
      d.classList.toggle("is-done", i < n);
    });
    wizRoot.querySelector(".wiz__head").scrollIntoView({ behavior: "smooth", block: "start" });
    if (n === 2) renderStep2();
    if (n === 4) renderResumo();
  }

  // ---------- ETAPA 1 ----------
  wizRoot.querySelectorAll("[data-modalidade]").forEach((card) => {
    card.addEventListener("click", function () {
      state.modalidade = card.dataset.modalidade;
      wizRoot.querySelectorAll("[data-modalidade]").forEach((c) => c.classList.toggle("is-selected", c === card));
      goToStep(2);
    });
  });

  // ---------- ETAPA 2 ----------
  function toggleSelecao(set, itemId, singleChoice) {
    if (singleChoice) {
      if (set.has(itemId)) set.clear();
      else { set.clear(); set.add(itemId); }
    } else {
      if (set.has(itemId)) set.delete(itemId);
      else set.add(itemId);
    }
  }

  function renderChipsCategoria(categoria, set) {
    const itens = itensDaCategoria(categoria.id);
    if (!itens.length) return "";
    const singleChoice = RADIO_CATEGORIAS.has(categoria.slug);
    const wrap = document.createElement("div");
    wrap.className = "wiz__cat";
    wrap.innerHTML =
      '<h4 class="wiz__cat-title">' + (CATEGORIA_LABELS[categoria.slug] || categoria.nome) + "</h4>" +
      '<div class="wiz__chips" data-chips="' + categoria.id + '"></div>';
    const chipsEl = wrap.querySelector("[data-chips]");
    itens.forEach((item) => {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "wiz__chip";
      chip.dataset.itemId = item.id;
      chip.setAttribute("aria-pressed", String(set.has(item.id)));
      chip.classList.toggle("is-selected", set.has(item.id));
      chip.innerHTML = '<span>' + item.nome + '</span>' + (item.descricao ? '<small>' + item.descricao + '</small>' : "");
      chip.addEventListener("click", function () {
        toggleSelecao(set, item.id, singleChoice);
        chip.classList.toggle("is-selected", set.has(item.id));
        chip.setAttribute("aria-pressed", String(set.has(item.id)));
        if (singleChoice) {
          chipsEl.querySelectorAll(".wiz__chip").forEach((c) => {
            if (c !== chip) { c.classList.remove("is-selected"); c.setAttribute("aria-pressed", "false"); }
          });
        }
      });
      chipsEl.appendChild(chip);
    });
    return wrap;
  }

  async function renderStep2() {
    const titleEl = wizRoot.querySelector("[data-step2-title]");
    const content = wizRoot.querySelector("[data-step2-content]");
    content.innerHTML = '<p class="wiz__loading">Carregando opções…</p>';
    try {
      await carregarCatalogo();
    } catch (err) {
      content.innerHTML = '<p class="wiz__erro" role="alert">Não foi possível carregar as opções agora. Verifique sua conexão e tente novamente.</p>';
      return;
    }
    content.innerHTML = "";

    if (state.modalidade === "pacote") {
      titleEl.textContent = "Escolha seu cardápio";
      const grid = document.createElement("div");
      grid.className = "wiz__pacotes";
      catalogo.pacotes.forEach((p) => {
        const card = document.createElement("button");
        card.type = "button";
        card.className = "wiz__pacote-card";
        card.classList.toggle("is-selected", state.pacoteId === p.id);
        card.innerHTML = "<h4>" + p.nome + "</h4><p>" + (p.descricao || "") + "</p>";
        card.addEventListener("click", function () {
          state.pacoteId = p.id;
          grid.querySelectorAll(".wiz__pacote-card").forEach((c) => c.classList.toggle("is-selected", c === card));
        });
        grid.appendChild(card);
      });
      content.appendChild(grid);
      const nota = document.createElement("p");
      nota.className = "wiz__nota";
      nota.textContent = "Nossa equipe vai apresentar os itens inclusos nesse cardápio durante o atendimento.";
      content.appendChild(nota);
    } else if (state.modalidade === "monte_cardapio") {
      titleEl.textContent = "Monte seu cardápio";
      const categorias = catalogo.categorias.filter((c) => c.grupo === "monte_cardapio");
      categorias.forEach((c) => {
        const el = renderChipsCategoria(c, state.selections.monte_cardapio);
        if (el) content.appendChild(el);
      });
      const adicionais = catalogo.categorias.find((c) => c.slug === "adicionais_brasa");
      if (adicionais) {
        const el = renderChipsCategoria(adicionais, state.selections.adicionais);
        if (el) content.appendChild(el);
      }
    } else if (state.modalidade === "festival_hamburguer") {
      titleEl.textContent = "Festival de Hambúrguer";
      const slugs = ["festival_burgers", "festival_acompanhamentos", "festival_sobremesas"];
      slugs.forEach((slug) => {
        const c = catalogo.categorias.find((cat) => cat.slug === slug);
        if (!c) return;
        const setKey = slug;
        const el = renderChipsCategoria(c, state.selections[setKey]);
        if (el) content.appendChild(el);
      });
      const nota = document.createElement("p");
      nota.className = "wiz__nota";
      nota.textContent = "Quer alterar algum ingrediente? Conte pra gente no campo de observações, na próxima etapa — sujeito à disponibilidade.";
      content.appendChild(nota);
    }
  }

  function validarEtapa2() {
    if (state.modalidade === "pacote") return !!state.pacoteId;
    if (state.modalidade === "monte_cardapio") return state.selections.monte_cardapio.size > 0;
    if (state.modalidade === "festival_hamburguer") return state.selections.festival_burgers.size > 0;
    return false;
  }

  // ---------- ETAPA 3 ----------
  const formEvento = wizRoot.querySelector("[data-form-evento]");
  const inputData = formEvento.querySelector("[data-data-evento]");
  if (inputData) inputData.min = new Date().toISOString().slice(0, 10);

  formEvento.querySelector("[data-qtd-criancas]").addEventListener("input", function (e) {
    const campo = formEvento.querySelector("[data-idades-criancas]");
    campo.hidden = Number(e.target.value || 0) <= 0;
    campo.querySelector("input").required = !campo.hidden;
  });

  formEvento.querySelectorAll("[data-buffet-radio]").forEach((r) => {
    r.addEventListener("change", function () {
      const campo = formEvento.querySelector("[data-louca-field]");
      const quer = formEvento.querySelector("[data-buffet-radio]:checked")?.value === "sim";
      campo.hidden = !quer;
      campo.querySelectorAll("input").forEach((i) => { i.required = quer; });
    });
  });

  function coletarEtapa3() {
    const d = new FormData(formEvento);
    state.evento = {
      nome_responsavel: (d.get("nome_responsavel") || "").toString().trim(),
      whatsapp: (d.get("whatsapp") || "").toString().trim(),
      email: (d.get("email") || "").toString().trim(),
      tipo_evento: (d.get("tipo_evento") || "").toString(),
      data_evento: (d.get("data_evento") || "").toString(),
      horario_inicio: (d.get("horario_inicio") || "").toString(),
      endereco: (d.get("endereco") || "").toString().trim(),
      cidade: (d.get("cidade") || "").toString().trim(),
      qtd_adultos: Number(d.get("qtd_adultos") || 0),
      qtd_criancas: Number(d.get("qtd_criancas") || 0),
      idades_criancas: (d.get("idades_criancas") || "").toString().trim(),
      qtd_equipe_apoio: Number(d.get("qtd_equipe_apoio") || 0),
      estrutura_churrasco: (d.get("estrutura_churrasco") || "").toString(),
      deseja_buffet: d.get("deseja_buffet") === "sim",
      tipo_louca: (d.get("tipo_louca") || "").toString(),
      observacoes: (d.get("observacoes") || "").toString().trim(),
    };
  }

  // ---------- ETAPA 4 — Resumo ----------
  function nomesSelecionados(set) {
    return Array.from(set).map((id) => itensPorId.get(id)?.nome).filter(Boolean);
  }

  function linhaResumo(label, valor) {
    if (!valor) return "";
    return '<div class="wiz__resumo-linha"><strong>' + label + "</strong><span>" + valor + "</span></div>";
  }

  function renderResumo() {
    const el = wizRoot.querySelector("[data-resumo]");
    let html = "";

    html += '<section class="wiz__resumo-bloco"><h4>Experiência <button type="button" class="wiz__editar" data-editar="1">Editar</button></h4>';
    html += linhaResumo("Modalidade", MODALIDADE_LABELS[state.modalidade] || "");
    if (state.modalidade === "pacote") {
      const p = catalogo.pacotes.find((x) => x.id === state.pacoteId);
      html += linhaResumo("Cardápio", p ? p.nome : "");
    }
    html += "</section>";

    html += '<section class="wiz__resumo-bloco"><h4>Itens escolhidos <button type="button" class="wiz__editar" data-editar="2">Editar</button></h4>';
    if (state.modalidade === "monte_cardapio") {
      html += linhaResumo("Cardápio", nomesSelecionados(state.selections.monte_cardapio).join(", "));
      html += linhaResumo("Adicionais na brasa", nomesSelecionados(state.selections.adicionais).join(", "));
    } else if (state.modalidade === "festival_hamburguer") {
      html += linhaResumo("Hambúrgueres", nomesSelecionados(state.selections.festival_burgers).join(", "));
      html += linhaResumo("Acompanhamentos", nomesSelecionados(state.selections.festival_acompanhamentos).join(", "));
      html += linhaResumo("Sobremesa", nomesSelecionados(state.selections.festival_sobremesas).join(", "));
    } else {
      html += linhaResumo("Itens", "A equipe Gazzotto vai apresentar os itens inclusos nesse cardápio.");
    }
    html += "</section>";

    const ev = state.evento;
    html += '<section class="wiz__resumo-bloco"><h4>Dados do evento <button type="button" class="wiz__editar" data-editar="3">Editar</button></h4>';
    html += linhaResumo("Responsável", ev.nome_responsavel);
    html += linhaResumo("WhatsApp", ev.whatsapp);
    html += linhaResumo("E-mail", ev.email);
    html += linhaResumo("Tipo de evento", ev.tipo_evento);
    html += linhaResumo("Data", ev.data_evento ? new Date(ev.data_evento + "T00:00:00").toLocaleDateString("pt-BR") : "");
    html += linhaResumo("Horário", ev.horario_inicio);
    html += linhaResumo("Local", [ev.endereco, ev.cidade].filter(Boolean).join(", "));
    html += linhaResumo("Adultos", String(ev.qtd_adultos || ""));
    html += linhaResumo("Crianças", ev.qtd_criancas ? ev.qtd_criancas + " (" + (ev.idades_criancas || "idades não informadas") + ")" : "");
    html += linhaResumo("Equipe de apoio", ev.qtd_equipe_apoio ? String(ev.qtd_equipe_apoio) : "");
    html += linhaResumo("Preparo do churrasco", ESTRUTURA_LABELS[ev.estrutura_churrasco] || "");
    html += linhaResumo("Buffet", ev.deseja_buffet ? "Sim — " + (LOUCA_LABELS[ev.tipo_louca] || "") : "Não");
    html += linhaResumo("Observações", ev.observacoes);
    html += "</section>";

    el.innerHTML = html;
    el.querySelectorAll("[data-editar]").forEach((b) => b.addEventListener("click", function () { goToStep(Number(b.dataset.editar)); }));
  }

  // ---------- Protocolo + envio ----------
  function gerarProtocolo() {
    const data = new Date();
    const yyyymmdd = data.toISOString().slice(0, 10).replace(/-/g, "");
    const sufixo = Math.random().toString(36).slice(2, 7).toUpperCase();
    return "GZT-" + yyyymmdd + "-" + sufixo;
  }

  function montarMensagemWhatsapp(protocolo) {
    const ev = state.evento;
    const linhas = [
      "Olá! Acabei de enviar um pedido de orçamento pelo site da Gazzotto BBQ.",
      "Protocolo: " + protocolo,
      "Experiência: " + (MODALIDADE_LABELS[state.modalidade] || ""),
      "Tipo de evento: " + ev.tipo_evento,
      "Data: " + (ev.data_evento ? new Date(ev.data_evento + "T00:00:00").toLocaleDateString("pt-BR") : ""),
      "Convidados: " + (ev.qtd_adultos || 0) + " adultos" + (ev.qtd_criancas ? " e " + ev.qtd_criancas + " crianças" : ""),
    ];
    return linhas.join("\n");
  }

  async function enviarOrcamento() {
    if (isSubmitting) return;
    isSubmitting = true;
    const btn = wizRoot.querySelector("[data-enviar]");
    const erroEl = wizRoot.querySelector("[data-erro-envio]");
    erroEl.hidden = true;
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    const textoOriginal = btn.textContent;
    btn.textContent = "Enviando…";

    const protocolo = gerarProtocolo();
    const orcamentoId = crypto.randomUUID();
    const ev = state.evento;

    try {
      // 1) Orçamento — sem .select() de propósito (ver nota no topo do script).
      const { error: errOrc } = await supabase.from("orcamentos").insert({
        id: orcamentoId,
        protocolo,
        modalidade: state.modalidade,
        pacote_id: state.modalidade === "pacote" ? state.pacoteId : null,
        nome_responsavel: ev.nome_responsavel,
        whatsapp: ev.whatsapp,
        email: ev.email || null,
        tipo_evento: ev.tipo_evento,
        data_evento: ev.data_evento,
        horario_inicio: ev.horario_inicio || null,
        endereco: ev.endereco || null,
        cidade: ev.cidade || null,
        qtd_adultos: ev.qtd_adultos || 0,
        qtd_criancas: ev.qtd_criancas || 0,
        idades_criancas: ev.idades_criancas || null,
        qtd_equipe_apoio: ev.qtd_equipe_apoio || 0,
        estrutura_churrasco: ev.estrutura_churrasco || null,
        deseja_buffet: !!ev.deseja_buffet,
        tipo_louca: ev.deseja_buffet ? ev.tipo_louca || null : null,
        observacoes: ev.observacoes || null,
      });
      if (errOrc) throw errOrc;

      // 2) Itens do orçamento (quando houver)
      const linhasItens = [];
      const add = (set, contexto) => Array.from(set).forEach((itemId) => linhasItens.push({ orcamento_id: orcamentoId, item_id: itemId, contexto, quantidade: 1 }));
      if (state.modalidade === "monte_cardapio") {
        add(state.selections.monte_cardapio, "monte_cardapio");
        add(state.selections.adicionais, "adicionais");
      } else if (state.modalidade === "festival_hamburguer") {
        add(state.selections.festival_burgers, "festival");
        add(state.selections.festival_acompanhamentos, "festival");
        add(state.selections.festival_sobremesas, "festival");
      }
      if (linhasItens.length) {
        const { error: errItens } = await supabase.from("orcamento_itens").insert(linhasItens);
        if (errItens) throw errItens;
      }

      renderConfirmacao(protocolo);
      goToStep(5);
    } catch (err) {
      console.error("Erro ao enviar orçamento:", err);
      erroEl.textContent = "Não conseguimos enviar seu pedido agora. Verifique sua internet e tente novamente — nada foi perdido.";
      erroEl.hidden = false;
    } finally {
      isSubmitting = false;
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      btn.textContent = textoOriginal;
    }
  }

  function renderConfirmacao(protocolo) {
    const el = wizRoot.querySelector("[data-confirmacao]");
    const waLink = WHATSAPP
      ? "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(montarMensagemWhatsapp(protocolo))
      : null;
    el.innerHTML =
      '<div class="wiz__ok-icon" aria-hidden="true">✓</div>' +
      "<h3>Pedido enviado com sucesso!</h3>" +
      '<p class="wiz__protocolo">Protocolo: <strong>' + protocolo + "</strong></p>" +
      "<p>Nossa equipe vai analisar seu pedido e preparar uma proposta. Guarde o protocolo acima.</p>" +
      (waLink ? '<a class="btn btn--red" href="' + waLink + '" target="_blank" rel="noopener">Falar agora no WhatsApp</a>' : "");
  }

  // ---------- Botões Voltar / Continuar ----------
  wizRoot.querySelectorAll("[data-back]").forEach((b) => b.addEventListener("click", function () { goToStep(currentStep - 1); }));
  wizRoot.querySelectorAll("[data-next]").forEach((b) => b.addEventListener("click", function () {
    if (currentStep === 2) {
      if (!validarEtapa2()) { alert("Escolha ao menos uma opção para continuar."); return; }
      goToStep(3);
    } else if (currentStep === 3) {
      if (!formEvento.reportValidity()) return;
      coletarEtapa3();
      goToStep(4);
    }
  }));
  wizRoot.querySelector("[data-enviar]").addEventListener("click", enviarOrcamento);

  // ---------- Animação de entrada (fade + leve subida), mesmo padrão de .moments__head ----------
  const reveals = Array.from(wizRoot.querySelectorAll("[data-reveal]"));
  if (reveals.length) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      reveals.forEach((el) => el.classList.add("is-visible"));
    } else if ("IntersectionObserver" in window) {
      const revealObs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add("is-visible"); revealObs.unobserve(entry.target); }
        });
      }, { threshold: 0.2 });
      reveals.forEach((el) => revealObs.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add("is-visible"));
    }
  }
</script>

<style is:global>
