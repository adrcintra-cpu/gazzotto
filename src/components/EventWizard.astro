.wiz__step-label { font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
.wiz__steps li.is-active .wiz__step-num { background: var(--burger); color: #fff; border-color: var(--burger); }
.wiz__steps li.is-active .wiz__step-label { color: var(--cream); }
