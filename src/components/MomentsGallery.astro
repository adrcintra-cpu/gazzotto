---
/**
 * "Momentos Gazzotto": carrossel horizontal de depoimentos.
 * Card ativo centralizado, com o anterior/próximo espiando nas laterais (efeito "peek").
 * Navegação por setas, arraste (mouse/trackpad) e swipe (touch); dots indicam a posição.
 * O scroll vertical da página nunca é afetado — não há scroll-jacking nem sticky gigante.
 * `prefers-reduced-motion`: mesma navegação, mas sem a transição deslizante (troca instantânea).
 */
import { media } from "../data/media";
import Icon from "./Icon.astro";

const items = media.moments || [];
---
<section class="moments" id="momentos" aria-label="Galeria de momentos Gazzotto BBQ">
  <div class="wrap moments__head">
    <h2 class="h2">Momentos Gazzotto</h2>
    <p>Quem já viveu a experiência Gazzotto BBQ conta como foi.</p>
  </div>
  {items.length > 0 && (
    <div
      class="moments__carousel"
      data-carousel
      tabindex="0"
      role="region"
      aria-roledescription="carrossel"
      aria-label="Depoimentos de clientes Gazzotto BBQ"
    >
      <div class="moments__viewport" data-viewport>
        <ul class="moments__track">
          {items.map((m, i) => (
            <li
              class="moments__slide"
              data-slide
              data-index={i}
              role="group"
              aria-roledescription="slide"
              aria-label={`Depoimento ${i + 1} de ${items.length}`}
            >
              <figure class="moments__card">
                <span class="moments__quote moments__quote--open" aria-hidden="true">&ldquo;</span>
                <blockquote class="moments__text">{m.quote}</blockquote>
                <span class="moments__divider" aria-hidden="true"></span>
                <div class="moments__stars" aria-hidden="true">★★★★★</div>
                <figcaption class="moments__attrib">
                  <span class="moments__avatar" aria-hidden="true"><Icon name="user" size={20} /></span>
                  <span class="moments__attrib-text">
                    <strong>{m.name}</strong>
                    <span>{m.event}</span>
                  </span>
                </figcaption>
                <span class="moments__quote moments__quote--close" aria-hidden="true">&rdquo;</span>
              </figure>
            </li>
          ))}
        </ul>
      </div>

      <button class="moments__arrow moments__arrow--prev" data-prev type="button" aria-label="Depoimento anterior">
        <Icon name="arrow" size={18} />
      </button>
      <button class="moments__arrow moments__arrow--next" data-next type="button" aria-label="Próximo depoimento">
        <Icon name="arrow" size={18} />
      </button>

      <div class="moments__dots" data-dots role="tablist" aria-label="Selecionar depoimento">
        {items.map((_, i) => (
          <button
            class="moments__dot"
            data-dot
            data-index={i}
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={`Ir para depoimento ${i + 1}`}
          ></button>
        ))}
      </div>

      <span class="sr moments__announcer" data-announcer aria-live="polite"></span>
    </div>
  )}
</section>

<style is:global>
.moments { background: var(--burger, #d83030); padding-block: 3.5rem 4rem; }
.moments__head {
  text-align: center; color: #fff; margin-top: 2.5rem;
  opacity: 0; transform: translateY(28px);
  transition: opacity .9s cubic-bezier(.16,.84,.44,1), transform .9s cubic-bezier(.16,.84,.44,1);
}
.moments__head.is-visible { opacity: 1; transform: translateY(0); }
.moments__head p { margin-top: .75rem; color: #fff; opacity: .8; font-size: .95rem; max-width: 42ch; margin-inline: auto; }

/* ---- Carrossel ------------------------------------------------------- */
.moments__carousel { position: relative; margin-top: 116px; outline: none; }
.moments__carousel:focus-visible { outline: 2px solid var(--fish); outline-offset: 10px; border-radius: 26px; }

.moments__viewport {
  position: relative; overflow: hidden; cursor: grab; touch-action: pan-y;
  -webkit-user-select: none; user-select: none;
}
.moments__viewport.is-dragging { cursor: grabbing; }

.moments__track { position: relative; height: 100%; list-style: none; margin: 0; padding: 0; }

.moments__slide {
  position: absolute; inset: 0; display: grid; place-items: center;
  transform: translateX(var(--tx, 0px)) scale(var(--sc, 1));
  opacity: var(--op, 1);
  z-index: var(--z, 1);
  transition: transform .7s cubic-bezier(.22,.75,.24,1), opacity .7s cubic-bezier(.22,.75,.24,1);
  will-change: transform, opacity;
  pointer-events: none;
}
.moments__slide.is-active { pointer-events: auto; }
.moments__viewport.is-dragging .moments__slide { transition: none; }

.moments__card {
  position: relative; width: min(70vw, 46rem); min-height: min(56vh, 27rem); border-radius: 20px;
  box-shadow: 0 16px 40px rgb(0 0 0 / .22);
  background: linear-gradient(160deg, #fffaf2 0%, #f3e3c9 100%);
  display: flex; flex-direction: column; justify-content: center;
  padding: clamp(2.2rem, 4vw, 3.5rem);
}
.moments__quote {
  position: absolute; font: 700 4.5rem/1 Georgia, "Times New Roman", serif; color: var(--burger); opacity: .3; pointer-events: none;
}
.moments__quote--open { top: .8rem; left: 1.6rem; }
.moments__quote--close { bottom: .3rem; right: 1.8rem; }
.moments__text {
  position: relative; z-index: 1; margin: 0; color: #2a2016;
  font: 400 clamp(1.05rem, 1.9vw, 1.3rem)/1.6 var(--font-body);
}
.moments__divider { position: relative; z-index: 1; width: 3rem; height: 2px; background: var(--burger); opacity: .6; margin: 1.6rem 0 1rem; border: 0; }
.moments__stars { position: relative; z-index: 1; color: var(--burger); font-size: 1rem; letter-spacing: .3rem; margin-bottom: .3rem; }
.moments__attrib { position: relative; z-index: 1; display: flex; align-items: center; gap: .85rem; }
.moments__avatar {
  flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center;
  background: rgb(216 48 48 / .12); color: var(--burger);
}
.moments__attrib-text strong { display: block; font: 600 1.4rem/1.3 var(--font-display, "Oswald", sans-serif); color: #241c14; letter-spacing: .02em; }
.moments__attrib-text span { display: block; font: 500 .85rem/1.4 var(--font-body); color: var(--burger); opacity: .85; margin-top: .2rem; }

/* Setas: minimalistas, na identidade da marca (creme + barbecue), discretas nas laterais */
.moments__arrow {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 20;
  width: 2.9rem; height: 2.9rem; border-radius: 50%; display: grid; place-items: center;
  background: var(--fish); color: var(--barbecue); border: 0; cursor: pointer;
  box-shadow: 0 10px 26px rgb(0 0 0 / .28);
  transition: background .25s, transform .25s, opacity .25s;
}
.moments__arrow:hover { background: #fff; }
.moments__arrow:active { transform: translateY(-50%) scale(.92); }
.moments__arrow[disabled] { opacity: .32; cursor: default; pointer-events: none; }
.moments__arrow--prev { left: clamp(.25rem, 2.4vw, 1.6rem); }
.moments__arrow--prev svg { transform: rotate(180deg); }
.moments__arrow--next { right: clamp(.25rem, 2.4vw, 1.6rem); }

/* Dots */
.moments__dots { display: flex; justify-content: center; align-items: center; gap: .6rem; margin-top: 1.8rem; }
.moments__dot {
  width: .5rem; height: .5rem; padding: 0; border: 0; border-radius: 50%;
  background: rgb(255 255 255 / .35); cursor: pointer; transition: background .25s, transform .25s;
}
.moments__dot:hover { background: rgb(255 255 255 / .6); }
.moments__dot.is-active { background: #fff; transform: scale(1.35); }

@media (max-width: 768px) {
  .moments__carousel { margin-top: 60px; }
  .moments__card { width: min(88vw, 30rem); min-height: auto; padding: 1.9rem 1.6rem 2.3rem; }
  .moments__quote { font-size: 3.2rem; }
  .moments__arrow { display: none; }
  .moments__dots { margin-top: 1.4rem; }
}

@media (prefers-reduced-motion: reduce) {
  .moments__head { opacity: 1 !important; transform: none !important; transition: none !important; }
  .moments__slide { transition: none !important; }
}
</style>

<script>
(function () {
  // Título/subtítulo: fade + leve subida ao entrar na tela (independente do carrossel).
  var heads = Array.prototype.slice.call(document.querySelectorAll(".moments__head"));
  if (heads.length) {
    if ("IntersectionObserver" in window) {
      var headObs = new IntersectionObserver(function (es) {
        es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("is-visible"); headObs.unobserve(en.target); } });
      }, { threshold: 0.3 });
      heads.forEach(function (h) { headObs.observe(h); });
    } else {
      heads.forEach(function (h) { h.classList.add("is-visible"); });
    }
  }

  var roots = Array.prototype.slice.call(document.querySelectorAll("[data-carousel]"));
  if (!roots.length) return;

  var clamp = function (v, a, b) { return Math.min(Math.max(v, a), b); };
  var mqMobile = matchMedia("(max-width: 768px)");
  var mqReduced = matchMedia("(prefers-reduced-motion: reduce)");

  roots.forEach(function (root) {
    var viewport = root.querySelector("[data-viewport]");
    var slides = Array.prototype.slice.call(root.querySelectorAll("[data-slide]"));
    var dots = Array.prototype.slice.call(root.querySelectorAll("[data-dot]"));
    var prevBtn = root.querySelector("[data-prev]");
    var nextBtn = root.querySelector("[data-next]");
    var announcer = root.querySelector("[data-announcer]");
    var N = slides.length;
    if (!N || !viewport) return;

    var active = 0;
    var step = 0;
    var dragging = false;
    var pointerId = null;
    var startX = 0;
    var dragPx = 0;
    var dragged = false;

    function measure() {
      var w = viewport.getBoundingClientRect().width || 1;
      step = w * (mqMobile.matches ? 0.84 : 0.73);
      var maxH = 0;
      slides.forEach(function (s) {
        var card = s.querySelector(".moments__card");
        if (card) maxH = Math.max(maxH, card.offsetHeight);
      });
      viewport.style.height = maxH ? maxH + "px" : "";
    }

    // Mapeia distância (em "unidades de slide", pode ser fracionária durante o arraste)
    // para transform/opacidade/z-index, com interpolação suave até 2 posições de distância.
    function paintFor(dist) {
      var a = clamp(Math.abs(dist), 0, 2);
      var scale, opacity;
      if (a <= 1) { scale = 1 - 0.07 * a; opacity = 1 - 0.45 * a; }
      else { scale = 0.93 - 0.05 * (a - 1); opacity = Math.max(0, 0.55 - 0.55 * (a - 1)); }
      return { tx: dist * step, scale: scale, opacity: opacity, z: Math.round(10 - a * 3) };
    }

    function render() {
      slides.forEach(function (s, i) {
        var dist = (i - active) - (dragPx / (step || 1));
        var p = paintFor(dist);
        s.style.setProperty("--tx", p.tx.toFixed(2) + "px");
        s.style.setProperty("--sc", p.scale.toFixed(4));
        s.style.setProperty("--op", p.opacity.toFixed(3));
        s.style.setProperty("--z", String(p.z));
        var isActive = i === active;
        s.classList.toggle("is-active", isActive);
        s.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
    }

    function updateControls() {
      dots.forEach(function (d, i) {
        var isActive = i === active;
        d.classList.toggle("is-active", isActive);
        d.setAttribute("aria-selected", isActive ? "true" : "false");
      });
      if (prevBtn) prevBtn.toggleAttribute("disabled", active === 0);
      if (nextBtn) nextBtn.toggleAttribute("disabled", active === N - 1);
      if (announcer) {
        var m = media_moments_names[active];
        announcer.textContent = "Depoimento " + (active + 1) + " de " + N + (m ? ": " + m : "");
      }
    }

    // Nomes para o anúncio de acessibilidade (lido do DOM, sem duplicar dados).
    var media_moments_names = slides.map(function (s) {
      var strong = s.querySelector(".moments__attrib-text strong");
      return strong ? strong.textContent : "";
    });

    function goTo(i) {
      active = clamp(i, 0, N - 1);
      dragPx = 0;
      render();
      updateControls();
    }
    function goPrev() { if (active > 0) goTo(active - 1); }
    function goNext() { if (active < N - 1) goTo(active + 1); }

    if (prevBtn) prevBtn.addEventListener("click", goPrev);
    if (nextBtn) nextBtn.addEventListener("click", goNext);
    dots.forEach(function (d, i) { d.addEventListener("click", function () { goTo(i); }); });

    root.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") { e.preventDefault(); goPrev(); }
      else if (e.key === "ArrowRight") { e.preventDefault(); goNext(); }
    });

    // Arraste (mouse/trackpad) e swipe (touch) via Pointer Events unificados.
    function onPointerDown(e) {
      if (e.button != null && e.button !== 0) return;
      dragging = true; dragged = false; startX = e.clientX; dragPx = 0; pointerId = e.pointerId;
      try { viewport.setPointerCapture(pointerId); } catch (err) {}
      viewport.classList.add("is-dragging");
    }
    function onPointerMove(e) {
      if (!dragging || e.pointerId !== pointerId) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 4) dragged = true;
      if ((active === 0 && dx > 0) || (active === N - 1 && dx < 0)) dx *= 0.35; // resistência nas pontas
      dragPx = dx;
      render();
    }
    function endDrag() {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove("is-dragging");
      var threshold = step * 0.18;
      if (dragPx <= -threshold && active < N - 1) active++;
      else if (dragPx >= threshold && active > 0) active--;
      dragPx = 0;
      render();
      updateControls();
    }
    viewport.addEventListener("pointerdown", onPointerDown);
    viewport.addEventListener("pointermove", onPointerMove);
    viewport.addEventListener("pointerup", endDrag);
    viewport.addEventListener("pointercancel", endDrag);
    viewport.addEventListener("click", function (e) { if (dragged) { e.preventDefault(); e.stopPropagation(); } }, true);

    // Scroll horizontal do trackpad (opcional): só intercepta gesto claramente horizontal,
    // nunca o scroll vertical da página.
    var wheelLock = false;
    viewport.addEventListener("wheel", function (e) {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) > 6) {
        e.preventDefault();
        if (wheelLock) return;
        wheelLock = true;
        if (e.deltaX > 0) goNext(); else goPrev();
        setTimeout(function () { wheelLock = false; }, 450);
      }
    }, { passive: false });

    addEventListener("resize", function () { measure(); render(); }, { passive: true });
    mqMobile.addEventListener ? mqMobile.addEventListener("change", function () { measure(); render(); }) : mqMobile.addListener(function () { measure(); render(); });

    if (mqReduced.matches) root.querySelectorAll(".moments__slide").forEach(function (s) { s.style.transition = "none"; });

    measure();
    render();
    updateControls();
  });
})();
</script>
