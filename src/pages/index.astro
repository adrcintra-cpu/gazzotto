        </a>
      </div>
    </div>
  </footer>

  <a class="wa-float" href={cta} target="_blank" rel="noopener" aria-label="Falar com a Gazzotto BBQ pelo WhatsApp">
    <svg viewBox="0 0 32 32" width="38" height="38" aria-hidden="true" fill="currentColor"><path d="M16.02 3C8.83 3 3 8.83 3 16.02c0 2.3.6 4.55 1.75 6.53L3 29l6.62-1.73a13 13 0 0 0 6.4 1.63h.01C23.2 28.9 29 23.07 29 15.98 29 8.83 23.2 3 16.02 3Zm0 23.7h-.01a10.7 10.7 0 0 1-5.45-1.49l-.39-.23-3.93 1.03 1.05-3.83-.25-.4a10.7 10.7 0 1 1 8.98 4.92Zm5.87-8c-.32-.16-1.9-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.27-.19.21-.37.24-.7.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.54.1-.21.05-.4-.03-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.08 1.3 3.3c.16.21 2.25 3.43 5.45 4.81.76.33 1.36.52 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37Z"/></svg>
    <span class="wa-float__tip">Fale conosco</span>
  </a>

  <script is:inline>
    // Menu: fica sólido ao rolar; no celular abre/fecha o painel.
    (function () {
      var h = document.getElementById("header"), t = document.getElementById("nav-toggle");
      function onScroll() { h.classList.toggle("is-solid", scrollY > 40); }
      addEventListener("scroll", onScroll, { passive: true }); onScroll();
      function setOpen(o) { h.classList.toggle("is-open", o); t.setAttribute("aria-expanded", String(o)); t.setAttribute("aria-label", o ? "Fechar menu" : "Abrir menu"); }
      t.addEventListener("click", function () { setOpen(!h.classList.contains("is-open")); });
      document.getElementById("nav").addEventListener("click", function (e) { if (e.target.closest("a")) setOpen(false); });
      addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
    })();
  </script>

  <script is:inline>
    // Vídeo institucional: toca sozinho (mudo) ao entrar na tela e pausa ao sair. Botão liga/desliga o som.
    (function () {
      var v = document.getElementById("about-video");
      if (!v) return;
      var btn = document.getElementById("about-sound");
      var rng = document.getElementById("about-range");
      v.muted = true; v.volume = rng ? parseFloat(rng.value) : 0.6;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) { v.removeAttribute("autoplay"); v.pause(); }
      else if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) v.play().catch(function () {}); else v.pause(); });
        }, { threshold: 0.35 }).observe(v);
      }
      function sync() {
        var on = !v.muted && v.volume > 0;
        btn.setAttribute("aria-pressed", String(on));
        btn.setAttribute("aria-label", on ? "Desativar som do vídeo" : "Ativar som do vídeo");
        btn.classList.toggle("is-on", on);
        if (rng) rng.value = v.muted ? 0 : v.volume;
      }
      if (btn) btn.addEventListener("click", function () {
        if (v.muted || v.volume === 0) { v.muted = false; if (v.volume === 0) v.volume = 0.6; v.play().catch(function () {}); }
        else v.muted = true;
        sync();
      });
      if (rng) rng.addEventListener("input", function () {
        var val = parseFloat(rng.value);
        v.volume = val; v.muted = val === 0;
        if (val > 0) v.play().catch(function () {});
        sync();
      });
    })();
  </script>

  <script is:inline>
    // Cardápios: no toque/teclado abre/fecha o painel (no mouse o hover já faz isso). Cliques no botão não alternam.
    document.querySelectorAll(".menu").forEach(function (c) {
      c.addEventListener("click", function (e) { if (!e.target.closest("a")) c.classList.toggle("is-open"); });
      c.addEventListener("keydown", function (e) { if (e.target === c && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); c.classList.toggle("is-open"); } });
    });
    // Cards "Nosso diferencial": no toque/teclado, alterna o giro (no mouse o hover já faz isso).
    document.querySelectorAll(".diff").forEach(function (c) {
      c.addEventListener("click", function () { c.classList.toggle("is-flipped"); });
      c.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); c.classList.toggle("is-flipped"); } });
    });
  </script>

  <Parallax />
  <TextScrub />

  <script is:inline>
    // Formulário sem back-end: abre WhatsApp (se configurado) ou e-mail com a mensagem pronta.
    // Troque por Formspree/Resend/endpoint próprio quando houver.
    document.getElementById("form").addEventListener("submit", function (e) {
      var f = e.currentTarget, d = new FormData(f);
      var txt = "Olá! Meu nome é " + d.get("nome") +
        ".\nE-mail: " + d.get("email") + "\nTelefone: " + d.get("telefone") + "\n\n" + d.get("mensagem");
      var wa = f.dataset.wa, mail = f.dataset.mail;
      if (!wa && !mail) return e.preventDefault();
      e.preventDefault();
      location.href = wa
        ? "https://wa.me/" + wa + "?text=" + encodeURIComponent(txt)
        : "mailto:" + mail + "?subject=" + encodeURIComponent("Orçamento — site") + "&body=" + encodeURIComponent(txt);
    });
  </script>
