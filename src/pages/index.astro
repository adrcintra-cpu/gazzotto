            <g fill="currentColor">
              <g>
                <path d="M217.3,50.9c14.7,0,24.4,7.6,24.4,22.2v17.1c0,14.8-9.8,22.3-24.6,22.3s-24.4-7.6-24.4-22.3v-17.1c0-14.7,9.7-22.2,24.6-22.2ZM217.2,104.8c9.4,0,15.5-4.7,15.5-14v-18.3c0-9.2-6.1-13.8-15.4-13.8s-15.5,4.7-15.5,13.8v18.3c0,9.3,6.2,14,15.4,14Z"/>
