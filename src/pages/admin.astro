---
import Layout from "../layouts/Layout.astro";
import { supabaseConfig } from "../data/media";
---
<Layout title="Painel | Gazzotto BBQ" description="Painel interno — leads e notificações." noindex>
  <main class="admin" id="admin-root">
    <!-- LOGIN -->
    <section class="admin__login" data-view="login">
      <form class="admin__login-card" data-login-form>
        <h1>Painel Gazzotto BBQ</h1>
        <p class="admin__hint">Entre com seu e-mail e senha de acesso.</p>
        <label class="admin__field">
          <span>E-mail</span>
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label class="admin__field">
          <span>Senha</span>
          <input type="password" name="senha" autocomplete="current-password" required />
        </label>
        <p class="admin__erro" data-login-erro hidden></p>
        <button type="submit" class="btn btn--red">Entrar</button>
        <button type="button" class="admin__link-btn" data-esqueci-abrir>Esqueceu a senha?</button>
      </form>

      <form class="admin__login-card admin__esqueci" data-esqueci-form hidden>
        <h1>Esqueci minha senha</h1>
        <p class="admin__hint">Informe seu e-mail de acesso. Vamos te mandar um link para criar uma senha nova.</p>
        <label class="admin__field">
          <span>E-mail</span>
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <p class="admin__erro" data-esqueci-msg hidden></p>
        <button type="submit" class="btn btn--red">Enviar link de redefinição</button>
        <button type="button" class="admin__link-btn" data-esqueci-cancelar>Voltar para o login</button>
      </form>
    </section>

    <!-- DEFINIR SENHA (primeiro acesso, via convite) -->
    <section class="admin__login" data-view="definir-senha" hidden>
      <form class="admin__login-card" data-senha-form>
        <h1>Defina sua senha</h1>
        <p class="admin__hint">Escolha uma senha de acesso definitiva para o painel Gazzotto BBQ.</p>
        <label class="admin__field">
          <span>Nova senha</span>
          <input type="password" name="senha" autocomplete="new-password" minlength="6" required />
        </label>
        <label class="admin__field">
          <span>Confirmar senha</span>
          <input type="password" name="confirmar" autocomplete="new-password" minlength="6" required />
        </label>
        <p class="admin__erro" data-senha-erro hidden></p>
        <button type="submit" class="btn btn--red">Definir senha e entrar</button>
      </form>
    </section>

    <!-- PAINEL -->
    <section class="admin__panel" data-view="panel" hidden>
      <header class="admin__bar">
        <h1>Painel Gazzotto BBQ</h1>
        <div class="admin__bar-actions">
          <span class="admin__user" data-usuario-logado></span>
          <button type="button" class="admin__btn-ghost" data-trocar-senha-abrir>Trocar senha</button>
          <button type="button" class="admin__btn-ghost" data-logout>Sair</button>
        </div>
      </header>

      <div class="admin__trocar-senha" data-trocar-senha-painel hidden>
        <form class="admin__add-contato" data-trocar-senha-form>
          <input type="password" name="senha" placeholder="Nova senha" autocomplete="new-password" minlength="6" required />
          <input type="password" name="confirmar" placeholder="Confirmar nova senha" autocomplete="new-password" minlength="6" required />
          <button type="submit" class="btn btn--red">Salvar nova senha</button>
          <button type="button" class="admin__btn-ghost" data-trocar-senha-cancelar>Cancelar</button>
        </form>
        <p class="admin__erro" data-trocar-senha-msg hidden></p>
      </div>

      <nav class="admin__tabs" aria-label="Seções do painel">
        <button type="button" class="admin__tab is-active" data-tab="leads">Leads</button>
        <button type="button" class="admin__tab" data-tab="notificacoes">Notificações WhatsApp</button>
        <button type="button" class="admin__tab" data-tab="colaboradores">Colaboradores</button>
      </nav>

      <div class="admin__view" data-tab-panel="leads">
        <div class="admin__toolbar">
          <h2>Pedidos recebidos</h2>
          <button type="button" class="admin__btn-ghost" data-reload-leads>Atualizar</button>
        </div>
        <p class="admin__hint">Clique em um pedido para ver todos os detalhes e preparar o orçamento.</p>
        <div class="admin__leads-grid" data-leads-grid>
          <p class="admin__loading">Carregando…</p>
        </div>
      </div>

      <!-- Modal de detalhes do lead -->
      <div class="admin__lead-modal" data-lead-modal hidden>
        <div class="admin__lead-modal-backdrop" data-lead-modal-fechar></div>
        <div class="admin__lead-modal-card" role="dialog" aria-modal="true">
          <button type="button" class="admin__lead-modal-x" data-lead-modal-fechar aria-label="Fechar">✕</button>
          <div data-lead-modal-conteudo></div>
        </div>
      </div>

      <div class="admin__view" data-tab-panel="notificacoes" hidden>
        <div class="admin__toolbar">
          <h2>Quem recebe o aviso de novo lead no WhatsApp</h2>
        </div>
        <p class="admin__hint">
          Cada novo pedido envia uma mensagem automática para os números ativos abaixo (via Z-API).
          Desative um contato sem precisar apagar, se for só uma pausa.
        </p>
        <form class="admin__add-contato" data-contato-form>
          <input type="text" name="nome" placeholder="Nome" required />
          <input type="tel" name="telefone" placeholder="Telefone (ex.: 5519991605930)" required />
          <button type="submit" class="btn btn--red">Adicionar</button>
        </form>
        <div class="admin__table-wrap">
          <table class="admin__table" data-contatos-table>
            <thead><tr><th>Nome</th><th>Telefone</th><th>Ativo</th><th></th></tr></thead>
            <tbody data-contatos-body>
              <tr><td colspan="4" class="admin__loading">Carregando…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="admin__view" data-tab-panel="colaboradores" hidden>
        <div class="admin__toolbar">
          <h2>Adicionar colaborador</h2>
        </div>
        <p class="admin__hint">
          Não depende de e-mail. Ao adicionar, geramos uma senha provisória aqui mesmo — copie e
          envie para a pessoa por WhatsApp (ou verbalmente). No primeiro acesso, ela é obrigada a
          trocar por uma senha própria, que ninguém mais vê ou define.
        </p>
        <form class="admin__add-contato" data-convite-form>
          <input type="email" name="email" placeholder="E-mail do colaborador" required />
          <button type="submit" class="btn btn--red">Adicionar e gerar senha</button>
        </form>
        <div class="admin__senha-gerada" data-senha-gerada hidden>
          <p>
            Colaborador <strong data-senha-gerada-email></strong> criado. Senha provisória:
            <code data-senha-gerada-valor></code>
            <button type="button" class="admin__btn-ghost admin__btn-small" data-copiar-senha>Copiar</button>
          </p>
          <p class="admin__hint">Envie essa senha por WhatsApp agora — ela só aparece aqui uma vez.</p>
        </div>
        <p class="admin__erro" data-convite-msg hidden></p>

        <div class="admin__toolbar" style="margin-top:2rem">
          <h2>Quem tem acesso</h2>
          <button type="button" class="admin__btn-ghost" data-reload-colaboradores>Atualizar</button>
        </div>
        <div class="admin__table-wrap">
          <table class="admin__table" data-colaboradores-table>
            <thead><tr><th>E-mail</th><th>Status</th><th>Último acesso</th><th></th></tr></thead>
            <tbody data-colaboradores-body>
              <tr><td colspan="4" class="admin__loading">Carregando…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="admin__erro" data-colaboradores-msg hidden></p>
      </div>
    </section>
  </main>
</Layout>

<script type="module" define:vars={{ SUPABASE_URL: supabaseConfig.url, SUPABASE_KEY: supabaseConfig.publishableKey }}>
  import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  const root = document.getElementById("admin-root");
  const loginView = root.querySelector('[data-view="login"]');
  const senhaView = root.querySelector('[data-view="definir-senha"]');
  const panelView = root.querySelector('[data-view="panel"]');
  const loginForm = root.querySelector("[data-login-form]");
  const loginErro = root.querySelector("[data-login-erro]");
  const senhaForm = root.querySelector("[data-senha-form]");
  const senhaErro = root.querySelector("[data-senha-erro]");
  const esqueciForm = root.querySelector("[data-esqueci-form]");
  const esqueciMsg = root.querySelector("[data-esqueci-msg]");

  // Link de convite/recuperação da Supabase chega com "type=invite" (ou "type=recovery") no
  // hash da URL — nesse caso, antes de mostrar o painel, pedimos pra pessoa criar a própria senha.
  // O mesmo vale quando o colaborador foi criado com senha provisória (sem e-mail): o painel
  // marca user_metadata.precisa_trocar_senha=true nesse caso, e checamos isso a cada sessão.
  let aguardandoSenha = /type=invite|type=recovery/.test(window.location.hash);
  function precisaDefinirSenha(session) {
    return aguardandoSenha || !!session?.user?.user_metadata?.precisa_trocar_senha;
  }

  const MODALIDADE_LABELS = {
    pacote: "Cardápios Gazzotto",
    monte_cardapio: "Monte seu Cardápio",
    festival_hamburguer: "Festival de Hambúrguer",
  };
  const ESTRUTURA_LABELS = { parrilla_gazzotto: "Parrilla da Gazzotto", churrasqueira_local: "Churrasqueira disponível no local" };
  const LOUCA_LABELS = { descartaveis: "Descartáveis", porcelana: "Louças de porcelana e talheres de inox" };
  const STATUS_LABELS = {
    novo: "Novo",
    em_analise: "Em análise",
    proposta_enviada: "Proposta enviada",
    aprovado: "Aprovado",
    cancelado: "Cancelado",
  };
  const CONTEXTO_LABELS = {
    monte_cardapio: "Cardápio (Monte o seu)",
    pacote: "Itens inclusos no pacote",
    adicionais: "Adicionais na brasa",
    festival: "Festival de Hambúrguer",
    buffet: "Buffet",
  };

  let carregado = false;

  function mostrarLogin() {
    panelView.hidden = true;
    senhaView.hidden = true;
    loginView.hidden = false;
    esqueciForm.hidden = true;
    loginForm.hidden = false;
    carregado = false;
  }

  function mostrarDefinirSenha() {
    panelView.hidden = true;
    loginView.hidden = true;
    senhaView.hidden = false;
  }

  let meuUserId = null;

  function mostrarPainel(email, userId) {
    loginView.hidden = true;
    senhaView.hidden = true;
    panelView.hidden = false;
    root.querySelector("[data-usuario-logado]").textContent = email || "";
    if (userId) meuUserId = userId;
    if (!carregado) {
      carregado = true;
      carregarLeads();
      carregarContatos();
      carregarColaboradores();
    }
  }

  // ---------- Sessão ----------
  async function verificarSessao() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session && precisaDefinirSenha(session)) mostrarDefinirSenha();
    else if (session) mostrarPainel(session.user.email, session.user.id);
    else mostrarLogin();
  }
  verificarSessao();

  supabase.auth.onAuthStateChange((_evento, session) => {
    if (session && precisaDefinirSenha(session)) mostrarDefinirSenha();
    else if (session) mostrarPainel(session.user.email, session.user.id);
    else mostrarLogin();
  });

  senhaForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    senhaErro.hidden = true;
    const fd = new FormData(senhaForm);
    const senha = fd.get("senha");
    if (senha !== fd.get("confirmar")) {
      senhaErro.textContent = "As senhas não são iguais.";
      senhaErro.hidden = false;
      return;
    }
    // data: {...} também limpa a flag de senha provisória (metadata do próprio usuário —
    // não precisa de service role, qualquer sessão pode atualizar seus próprios metadados).
    const { data, error } = await supabase.auth.updateUser({ password: senha, data: { precisa_trocar_senha: false } });
    if (error) {
      senhaErro.textContent = "Não foi possível definir a senha: " + error.message;
      senhaErro.hidden = false;
      return;
    }
    aguardandoSenha = false;
    history.replaceState(null, "", window.location.pathname);
    senhaForm.reset();
    mostrarPainel(data.user?.email, data.user?.id);
  });

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    loginErro.hidden = true;
    const fd = new FormData(loginForm);
    const { data, error } = await supabase.auth.signInWithPassword({
      email: fd.get("email"),
      password: fd.get("senha"),
    });
    if (error) {
      loginErro.textContent = "E-mail ou senha incorretos.";
      loginErro.hidden = false;
      return;
    }
    loginForm.reset();
    // Mostra o painel na hora, sem depender só do onAuthStateChange (no Safari esse aviso
    // às vezes demora/não dispara a tempo, e a tela ficava voltando pro login em branco).
    // Colaborador com senha provisória (primeiro login) cai na tela de definir senha, não no painel.
    if (precisaDefinirSenha(data.session)) mostrarDefinirSenha();
    else mostrarPainel(data.user?.email, data.user?.id);
  });

  // ---------- Esqueci minha senha ----------
  root.querySelector("[data-esqueci-abrir]").addEventListener("click", () => {
    loginForm.hidden = true;
    esqueciMsg.hidden = true;
    esqueciForm.reset();
    esqueciForm.hidden = false;
  });
  root.querySelector("[data-esqueci-cancelar]").addEventListener("click", () => {
    esqueciForm.hidden = true;
    esqueciMsg.hidden = true;
    esqueciForm.reset();
    loginForm.hidden = false;
  });
  esqueciForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    esqueciMsg.hidden = true;
    const email = new FormData(esqueciForm).get("email");
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + "/",
    });
    if (error) {
      esqueciMsg.textContent = "Não foi possível enviar o link: " + error.message;
      esqueciMsg.style.color = "var(--burger)";
    } else {
      esqueciMsg.textContent = "Se esse e-mail tiver cadastro, um link de redefinição foi enviado agora.";
      esqueciMsg.style.color = "var(--chicken)";
    }
    esqueciMsg.hidden = false;
  });

  root.querySelector("[data-logout]").addEventListener("click", async () => {
    await supabase.auth.signOut();
  });

  // ---------- Trocar senha (usuário já logado) ----------
  const trocarSenhaPainel = root.querySelector("[data-trocar-senha-painel]");
  const trocarSenhaForm = root.querySelector("[data-trocar-senha-form]");
  const trocarSenhaMsg = root.querySelector("[data-trocar-senha-msg]");

  root.querySelector("[data-trocar-senha-abrir]").addEventListener("click", () => {
    trocarSenhaPainel.hidden = !trocarSenhaPainel.hidden;
  });
  root.querySelector("[data-trocar-senha-cancelar]").addEventListener("click", () => {
    trocarSenhaForm.reset();
    trocarSenhaMsg.hidden = true;
    trocarSenhaPainel.hidden = true;
  });
  trocarSenhaForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    trocarSenhaMsg.hidden = true;
    const fd = new FormData(trocarSenhaForm);
    const senha = fd.get("senha");
    if (senha !== fd.get("confirmar")) {
      trocarSenhaMsg.textContent = "As senhas não são iguais.";
      trocarSenhaMsg.style.color = "var(--burger)";
      trocarSenhaMsg.hidden = false;
      return;
    }
    const { error } = await supabase.auth.updateUser({ password: senha });
    trocarSenhaForm.reset();
    if (error) {
      trocarSenhaMsg.textContent = "Não foi possível trocar a senha: " + error.message;
      trocarSenhaMsg.style.color = "var(--burger)";
    } else {
      trocarSenhaMsg.textContent = "Senha atualizada com sucesso.";
      trocarSenhaMsg.style.color = "var(--chicken)";
    }
    trocarSenhaMsg.hidden = false;
  });

  // ---------- Abas ----------
  root.querySelectorAll("[data-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      root.querySelectorAll("[data-tab]").forEach((t) => t.classList.toggle("is-active", t === tab));
      root.querySelectorAll("[data-tab-panel]").forEach((p) => { p.hidden = p.dataset.tabPanel !== tab.dataset.tab; });
    });
  });

  // ---------- Leads ----------
  // Dados vêm de um formulário público (sem login) -- nunca confiamos no texto livre pra montar
  // HTML diretamente, por segurança (evita que alguém injete tags/script num campo como nome ou
  // observações e isso rode na tela do colaborador que abrir o pedido).
  function esc(valor) {
    return String(valor == null ? "" : valor).replace(/[&<>"']/g, (c) => (
      { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]
    ));
  }

  let leadsPorId = new Map();

  async function carregarLeads() {
    const grid = root.querySelector("[data-leads-grid]");
    grid.innerHTML = '<p class="admin__loading">Carregando…</p>';
    const { data, error } = await supabase
      .from("orcamentos")
      .select(`
        *,
        pacotes ( nome, descricao, pacote_regras ( pacote_regra_itens ( itens ( nome ) ) ) ),
        orcamento_itens ( item_id, contexto, quantidade, observacao, itens ( nome ) )
      `)
      .order("created_at", { ascending: false });
    if (error) {
      grid.innerHTML = '<p class="admin__erro-cel">Erro ao carregar: ' + esc(error.message) + "</p>";
      return;
    }
    leadsPorId = new Map(data.map((o) => [o.id, o]));
    if (!data.length) {
      grid.innerHTML = '<p class="admin__loading">Nenhum pedido recebido ainda.</p>';
      return;
    }
    grid.innerHTML = data.map((o) => `
      <button type="button" class="admin__lead-card" data-lead-id="${o.id}">
        <div class="admin__lead-card-top">
          <span class="admin__lead-card-protocolo">${esc(o.protocolo)}</span>
          <span class="admin__status admin__status--${esc(o.status)}">${STATUS_LABELS[o.status] || esc(o.status)}</span>
        </div>
        <h3>${esc(o.nome_responsavel)}</h3>
        <p class="admin__lead-card-info">${MODALIDADE_LABELS[o.modalidade] || esc(o.modalidade)} · ${esc(o.tipo_evento) || "-"}</p>
        <p class="admin__lead-card-info">${o.data_evento ? new Date(o.data_evento + "T00:00:00").toLocaleDateString("pt-BR") : "sem data"} · ${o.qtd_adultos || 0} adultos${o.qtd_criancas ? " + " + o.qtd_criancas + "c" : ""}</p>
        <p class="admin__lead-card-recebido">Recebido em ${new Date(o.created_at).toLocaleString("pt-BR")}</p>
      </button>
    `).join("");
  }
  root.querySelector("[data-reload-leads]").addEventListener("click", carregarLeads);

  root.querySelector("[data-leads-grid]").addEventListener("click", (e) => {
    const card = e.target.closest("[data-lead-id]");
    if (!card) return;
    const lead = leadsPorId.get(card.dataset.leadId);
    if (lead) abrirLead(lead);
  });

  // ---------- Modal de detalhes do lead ----------
  const leadModal = root.querySelector("[data-lead-modal]");
  const leadModalConteudo = leadModal.querySelector("[data-lead-modal-conteudo]");

  function fecharLeadModal() {
    leadModal.hidden = true;
    leadModalConteudo.innerHTML = "";
  }
  leadModal.querySelectorAll("[data-lead-modal-fechar]").forEach((el) => el.addEventListener("click", fecharLeadModal));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !leadModal.hidden) fecharLeadModal(); });

  function linha(label, valor) {
    if (valor === null || valor === undefined || valor === "") return "";
    return `<div class="admin__lead-linha"><strong>${label}</strong><span>${valor}</span></div>`;
  }

  function itensDoPacote(pacote) {
    if (!pacote?.pacote_regras) return [];
    return pacote.pacote_regras.flatMap((r) => (r.pacote_regra_itens || []).map((ri) => ri.itens?.nome)).filter(Boolean);
  }

  function abrirLead(o) {
    const porContexto = {};
    (o.orcamento_itens || []).forEach((oi) => {
      const nome = oi.itens?.nome;
      if (!nome) return;
      (porContexto[oi.contexto] ||= []).push(nome + (oi.quantidade > 1 ? ` (×${oi.quantidade})` : ""));
    });

    let html = `<h3 class="admin__lead-modal-titulo">${esc(o.protocolo)}</h3>`;

    html += '<section class="admin__lead-secao"><h4>Responsável</h4>';
    html += linha("Nome", esc(o.nome_responsavel));
    html += linha("WhatsApp", `<a href="https://wa.me/${esc(o.whatsapp)}" target="_blank" rel="noopener">${esc(o.whatsapp)}</a>`);
    html += "</section>";

    html += '<section class="admin__lead-secao"><h4>Evento</h4>';
    html += linha("Experiência", MODALIDADE_LABELS[o.modalidade] || esc(o.modalidade));
    html += linha("Tipo de evento", esc(o.tipo_evento));
    html += linha("Data", o.data_evento ? new Date(o.data_evento + "T00:00:00").toLocaleDateString("pt-BR") : "");
    html += linha("Horário", o.horario_inicio ? o.horario_inicio.slice(0, 5) : "");
    html += linha("Local", esc([o.endereco, o.cidade].filter(Boolean).join(", ")));
    html += linha("Preparo do churrasco", ESTRUTURA_LABELS[o.estrutura_churrasco] || "");
    html += "</section>";

    html += '<section class="admin__lead-secao"><h4>Convidados</h4>';
    html += linha("Adultos", String(o.qtd_adultos || 0));
    html += linha("Crianças (até 12 anos)", o.qtd_criancas ? String(o.qtd_criancas) : "");
    html += linha("Equipe de apoio / fornecedores", o.qtd_equipe_apoio ? String(o.qtd_equipe_apoio) + " pessoas" : "");
    html += "</section>";

    html += '<section class="admin__lead-secao"><h4>Cardápio</h4>';
    if (o.modalidade === "pacote" && o.pacotes) {
      html += linha("Pacote", esc(o.pacotes.nome));
      const inclusos = itensDoPacote(o.pacotes);
      if (inclusos.length) html += linha("Itens inclusos", esc(inclusos.join(", ")));
    }
    Object.keys(CONTEXTO_LABELS).forEach((ctx) => {
      if (ctx === "pacote" || !porContexto[ctx]) return;
      html += linha(CONTEXTO_LABELS[ctx], esc(porContexto[ctx].join(", ")));
    });
    html += linha("Buffet", o.deseja_buffet ? "Sim" + (o.tipo_louca ? " — " + (LOUCA_LABELS[o.tipo_louca] || "") : "") : "Não");
    html += "</section>";

    if (o.observacoes) {
      html += '<section class="admin__lead-secao"><h4>Observações do cliente</h4>';
      html += `<p class="admin__lead-obs-cliente">${esc(o.observacoes)}</p>`;
      html += "</section>";
    }

    html += '<section class="admin__lead-secao"><h4>Administração</h4>';
    html += `
      <form class="admin__lead-form" data-lead-form data-lead-id="${o.id}">
        <label class="admin__field">
          <span>Status</span>
          <select name="status">
            ${Object.entries(STATUS_LABELS).map(([v, l]) => `<option value="${v}" ${v === o.status ? "selected" : ""}>${l}</option>`).join("")}
          </select>
        </label>
        <label class="admin__field">
          <span>Valor do orçamento (R$)</span>
          <input type="number" name="valor_manual" step="0.01" min="0" value="${o.valor_manual ?? ""}" placeholder="ainda não definido" />
        </label>
        <label class="admin__field admin__field--full">
          <span>Observações internas (só a equipe vê)</span>
          <textarea name="observacoes_internas" rows="3">${esc(o.observacoes_internas || "")}</textarea>
        </label>
        <button type="submit" class="btn btn--red">Salvar</button>
        <span class="admin__lead-form-msg" data-lead-form-msg hidden></span>
      </form>
    `;
    html += "</section>";

    html += `<p class="admin__lead-recebido-full">Recebido em ${new Date(o.created_at).toLocaleString("pt-BR")}</p>`;

    leadModalConteudo.innerHTML = html;
    leadModal.hidden = false;

    leadModalConteudo.querySelector("[data-lead-form]").addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const msg = form.querySelector("[data-lead-form-msg]");
      const fd = new FormData(form);
      const valorStr = fd.get("valor_manual");
      const { error } = await supabase.from("orcamentos").update({
        status: fd.get("status"),
        valor_manual: valorStr === "" ? null : Number(valorStr),
        observacoes_internas: fd.get("observacoes_internas") || null,
      }).eq("id", form.dataset.leadId);
      msg.hidden = false;
      if (error) {
        msg.textContent = "Erro ao salvar: " + error.message;
        msg.style.color = "var(--burger)";
      } else {
        msg.textContent = "Salvo.";
        msg.style.color = "var(--chicken)";
        carregarLeads();
      }
    });
  }

  // ---------- Notificações ----------
  async function carregarContatos() {
    const body = root.querySelector("[data-contatos-body]");
    body.innerHTML = '<tr><td colspan="4" class="admin__loading">Carregando…</td></tr>';
    const { data, error } = await supabase
      .from("notificacao_contatos")
      .select("id, nome, telefone, ativo")
      .order("criado_em", { ascending: true });
    if (error) {
      body.innerHTML = '<tr><td colspan="4" class="admin__erro-cel">Erro ao carregar: ' + error.message + "</td></tr>";
      return;
    }
    if (!data.length) {
      body.innerHTML = '<tr><td colspan="4" class="admin__loading">Nenhum contato cadastrado.</td></tr>';
      return;
    }
    body.innerHTML = data.map((c) => `
      <tr data-contato-row="${c.id}">
        <td>${c.nome}</td>
        <td>${c.telefone}</td>
        <td>
          <label class="admin__switch">
            <input type="checkbox" data-toggle-ativo="${c.id}" ${c.ativo ? "checked" : ""} />
            <span>${c.ativo ? "Ativo" : "Pausado"}</span>
          </label>
        </td>
        <td><button type="button" class="admin__btn-ghost admin__btn-small" data-remover="${c.id}">Remover</button></td>
      </tr>
    `).join("");

    body.querySelectorAll("[data-toggle-ativo]").forEach((input) => {
      input.addEventListener("change", async (e) => {
        const id = e.target.dataset.toggleAtivo;
        await supabase.from("notificacao_contatos").update({ ativo: e.target.checked }).eq("id", id);
        carregarContatos();
      });
    });
    body.querySelectorAll("[data-remover]").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = e.target.dataset.remover;
        if (!confirm("Remover este contato de notificação?")) return;
        await supabase.from("notificacao_contatos").delete().eq("id", id);
        carregarContatos();
      });
    });
  }

  root.querySelector("[data-contato-form]").addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);
    const telefone = fd.get("telefone").toString().replace(/\D/g, "");
    await supabase.from("notificacao_contatos").insert({ nome: fd.get("nome"), telefone, ativo: true });
    form.reset();
    carregarContatos();
  });

  // ---------- Convidar colaborador ----------
  const conviteMsg = root.querySelector("[data-convite-msg]");
  const senhaGeradaBox = root.querySelector("[data-senha-gerada]");
  root.querySelector("[data-convite-form]").addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target;
    conviteMsg.hidden = true;
    senhaGeradaBox.hidden = true;
    const fd = new FormData(form);
    const email = fd.get("email");
    const { data: { session } } = await supabase.auth.getSession();
    try {
      const resp = await fetch(`${SUPABASE_URL}/functions/v1/colaboradores`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${session.access_token}`,
          apikey: SUPABASE_KEY,
        },
        body: JSON.stringify({ action: "criar", email }),
      });
      const resultado = await resp.json();
      if (!resp.ok || !resultado.ok) throw new Error(resultado.error || "falha ao adicionar colaborador");
      senhaGeradaBox.querySelector("[data-senha-gerada-email]").textContent = resultado.email;
      senhaGeradaBox.querySelector("[data-senha-gerada-valor]").textContent = resultado.senha_provisoria;
      senhaGeradaBox.hidden = false;
      form.reset();
      carregarColaboradores();
    } catch (err) {
      conviteMsg.textContent = "Não foi possível adicionar o colaborador: " + err.message;
      conviteMsg.style.color = "var(--burger)";
      conviteMsg.hidden = false;
    }
  });

  senhaGeradaBox.querySelector("[data-copiar-senha]").addEventListener("click", async (e) => {
    const senha = senhaGeradaBox.querySelector("[data-senha-gerada-valor]").textContent;
    try {
      await navigator.clipboard.writeText(senha);
      const original = e.target.textContent;
      e.target.textContent = "Copiado!";
      setTimeout(() => { e.target.textContent = original; }, 1500);
    } catch {
      // clipboard indisponível (ex.: contexto não seguro) -- a senha já está visível na tela.
    }
  });

  // ---------- Quem tem acesso (listar/excluir) ----------
  const colaboradoresMsg = root.querySelector("[data-colaboradores-msg]");

  async function carregarColaboradores() {
    const body = root.querySelector("[data-colaboradores-body]");
    body.innerHTML = '<tr><td colspan="4" class="admin__loading">Carregando…</td></tr>';
    colaboradoresMsg.hidden = true;
    const { data: { session } } = await supabase.auth.getSession();
    try {
      const resp = await fetch(`${SUPABASE_URL}/functions/v1/colaboradores`, {
        method: "GET",
        headers: { Authorization: `Bearer ${session.access_token}`, apikey: SUPABASE_KEY },
      });
      const resultado = await resp.json();
      if (!resp.ok || !resultado.ok) throw new Error(resultado.error || "falha ao carregar colaboradores");
      const lista = resultado.colaboradores || [];
      if (!lista.length) {
        body.innerHTML = '<tr><td colspan="4" class="admin__loading">Nenhum colaborador encontrado.</td></tr>';
        return;
      }
      body.innerHTML = lista.map((c) => {
        const souEu = c.id === meuUserId;
        const status = c.precisa_trocar_senha ? "Senha provisória" : (c.confirmado ? "Ativo" : "Convite pendente");
        return `
        <tr data-colaborador-row="${c.id}">
          <td>${c.email}${souEu ? " (você)" : ""}</td>
          <td>${status}</td>
          <td>${c.ultimo_acesso ? new Date(c.ultimo_acesso).toLocaleString("pt-BR") : "nunca acessou"}</td>
          <td>${souEu ? "" : `<button type="button" class="admin__btn-ghost admin__btn-small" data-excluir-colaborador="${c.id}">Excluir</button>`}</td>
        </tr>
      `;
      }).join("");

      body.querySelectorAll("[data-excluir-colaborador]").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const id = e.target.dataset.excluirColaborador;
          const email = e.target.closest("tr").querySelector("td").textContent;
          if (!confirm(`Remover o acesso de ${email} ao painel? Essa ação não pode ser desfeita.`)) return;
          colaboradoresMsg.hidden = true;
          try {
            const resp = await fetch(`${SUPABASE_URL}/functions/v1/colaboradores`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${session.access_token}`,
                apikey: SUPABASE_KEY,
              },
              body: JSON.stringify({ action: "excluir", id }),
            });
            const resultado = await resp.json();
            if (!resp.ok || !resultado.ok) throw new Error(resultado.error || "falha ao excluir");
            carregarColaboradores();
          } catch (err) {
            colaboradoresMsg.textContent = "Não foi possível excluir: " + err.message;
            colaboradoresMsg.style.color = "var(--burger)";
            colaboradoresMsg.hidden = false;
          }
        });
      });
    } catch (err) {
      body.innerHTML = '<tr><td colspan="4" class="admin__erro-cel">Erro ao carregar: ' + err.message + "</td></tr>";
    }
  }
  root.querySelector("[data-reload-colaboradores]").addEventListener("click", carregarColaboradores);
</script>

<style is:global>
.admin { min-height: 100vh; padding: 6rem 1.5rem 4rem; max-width: 1100px; margin-inline: auto; }

.admin__hint { font-size: .8rem; color: var(--muted); }

.admin__login { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem; }
.admin__login-card { width: 100%; max-width: 340px; display: flex; flex-direction: column; gap: 1rem; background: color-mix(in srgb, var(--bg-dark) 92%, white 8%); border: 1px solid var(--line); border-radius: 14px; padding: 2rem 1.75rem; }
/* O atributo "hidden" sozinho perde pro "display:flex" das duas regras acima (mesma
   especificidade, e a regra do autor sempre vence a do navegador) — sem isto, o formulário
   de "Esqueci minha senha" ficava lado a lado com o de login em vez de substituí-lo. */
.admin__login[hidden], .admin__login-card[hidden] { display: none; }
.admin__login-card h1 { font: 400 1.3rem var(--font-display); color: var(--cream); text-align: center; }
.admin__login-card .admin__hint { text-align: center; margin-top: -.5rem; }
.admin__field { display: flex; flex-direction: column; gap: .4rem; font-size: .8rem; color: var(--muted); }
.admin__field input { padding: .6rem .75rem; border-radius: 6px; border: 1px solid color-mix(in srgb, var(--fish) 35%, transparent); background: transparent; color: var(--cream); font: inherit; font-size: .9rem; }
.admin__erro { font-size: .8rem; color: var(--burger); margin: -.3rem 0 0; }
.admin__link-btn { background: transparent; border: 0; padding: 0; margin-top: -.3rem; color: var(--chicken); font: 600 .78rem var(--font-body); text-decoration: underline; cursor: pointer; }
.admin__link-btn:hover { opacity: .85; }

.admin__bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; gap: 1rem; flex-wrap: wrap; }
.admin__bar h1 { font: 400 1.5rem var(--font-display); color: var(--cream); }
.admin__bar-actions { display: flex; align-items: center; gap: 1rem; }
.admin__user { font-size: .8rem; color: var(--muted); }
.admin__btn-ghost { background: transparent; border: 1px solid var(--line); color: var(--cream); padding: .5rem 1rem; border-radius: 6px; cursor: pointer; font: 600 .78rem var(--font-body); }
.admin__btn-ghost:hover { border-color: var(--chicken); }
.admin__btn-small { padding: .3rem .7rem; font-size: .72rem; }

.admin__trocar-senha { margin-bottom: 1.5rem; padding: 1rem; border: 1px solid var(--line); border-radius: 10px; }

.admin__tabs { display: flex; gap: .5rem; border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
.admin__tab { background: transparent; border: 0; color: var(--muted); padding: .7rem 1rem; cursor: pointer; font: 600 .82rem var(--font-body); border-bottom: 2px solid transparent; }
.admin__tab.is-active { color: var(--cream); border-bottom-color: var(--burger); }

.admin__toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; gap: 1rem; flex-wrap: wrap; }
.admin__toolbar h2 { font: 700 1rem var(--font-body); color: var(--cream); }

.admin__table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
.admin__table { width: 100%; border-collapse: collapse; font-size: .82rem; white-space: nowrap; }
.admin__table th, .admin__table td { padding: .65rem .9rem; text-align: left; border-bottom: 1px solid var(--line); color: var(--text); }
.admin__table th { color: var(--chicken); text-transform: uppercase; font-size: .68rem; letter-spacing: .04em; }
.admin__table tbody tr:last-child td { border-bottom: 0; }
.admin__table a { color: var(--chicken); }
.admin__loading, .admin__erro-cel { color: var(--muted); white-space: normal; }
.admin__status { text-transform: capitalize; }

.admin__add-contato { display: flex; gap: .6rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
.admin__add-contato input { padding: .55rem .75rem; border-radius: 6px; border: 1px solid color-mix(in srgb, var(--fish) 35%, transparent); background: transparent; color: var(--cream); font: inherit; font-size: .85rem; flex: 1; min-width: 180px; }

.admin__switch { display: flex; align-items: center; gap: .5rem; font-size: .78rem; color: var(--muted); cursor: pointer; }

.admin__senha-gerada { margin: -.4rem 0 1.2rem; padding: 1rem 1.2rem; border: 1px solid var(--chicken); border-radius: 10px; background: color-mix(in srgb, var(--chicken) 10%, transparent); }
.admin__senha-gerada p { color: var(--cream); font-size: .85rem; margin: 0 0 .4rem; }
.admin__senha-gerada p:last-child { margin-bottom: 0; }
.admin__senha-gerada code { padding: .2rem .5rem; border-radius: 5px; background: color-mix(in srgb, var(--bg-dark) 85%, white 15%); color: var(--chicken); font-weight: 700; letter-spacing: .03em; }

/* Leads em cards + modal de detalhes */
.admin__leads-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
.admin__lead-card {
  text-align: left; background: var(--card, color-mix(in srgb, var(--bg-dark) 92%, white 8%));
  border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.1rem; cursor: pointer; color: var(--text);
  display: flex; flex-direction: column; gap: .35rem; font: inherit;
}
.admin__lead-card:hover { border-color: var(--chicken); }
.admin__lead-card-top { display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
.admin__lead-card-protocolo { font-size: .7rem; color: var(--muted); letter-spacing: .02em; }
.admin__lead-card h3 { font: 700 1rem var(--font-body); color: var(--cream); margin: 0; }
.admin__lead-card-info { font-size: .8rem; color: var(--text); margin: 0; }
.admin__lead-card-recebido { font-size: .7rem; color: var(--muted); margin: .2rem 0 0; }

.admin__status { text-transform: capitalize; padding: .2rem .55rem; border-radius: 999px; font-size: .68rem; font-weight: 700; white-space: nowrap; background: color-mix(in srgb, var(--fish) 30%, transparent); color: var(--cream); }
.admin__status--novo { background: color-mix(in srgb, var(--chicken) 30%, transparent); color: var(--chicken); }
.admin__status--em_analise { background: color-mix(in srgb, var(--fish) 35%, transparent); }
.admin__status--proposta_enviada { background: color-mix(in srgb, #3b82f6 30%, transparent); color: #93c5fd; }
.admin__status--aprovado { background: color-mix(in srgb, #22c55e 30%, transparent); color: #86efac; }
.admin__status--cancelado { background: color-mix(in srgb, var(--burger) 30%, transparent); color: #fca5a5; }

.admin__lead-modal { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 1.5rem; }
.admin__lead-modal[hidden] { display: none; }
.admin__lead-modal-backdrop { position: absolute; inset: 0; background: rgb(0 0 0 / .6); }
.admin__lead-modal-card {
  position: relative; z-index: 1; width: 100%; max-width: 640px; max-height: 88vh; overflow-y: auto;
  background: var(--bg-dark); border: 1px solid var(--line); border-radius: 14px; padding: 2rem 1.8rem;
}
.admin__lead-modal-x { position: absolute; top: 1rem; right: 1rem; background: transparent; border: 0; color: var(--muted); font-size: 1.1rem; cursor: pointer; line-height: 1; padding: .3rem; }
.admin__lead-modal-x:hover { color: var(--cream); }
.admin__lead-modal-titulo { font: 400 1.2rem var(--font-display); color: var(--cream); margin: 0 0 1.2rem; }
.admin__lead-secao { margin-bottom: 1.4rem; }
.admin__lead-secao h4 { font: 700 .78rem var(--font-body); text-transform: uppercase; letter-spacing: .04em; color: var(--chicken); margin: 0 0 .6rem; }
.admin__lead-linha { display: grid; grid-template-columns: 11rem 1fr; gap: .5rem; font-size: .84rem; padding: .3rem 0; border-bottom: 1px solid var(--line); }
.admin__lead-linha strong { color: var(--muted); font-weight: 600; }
.admin__lead-linha span { color: var(--text); }
.admin__lead-linha a { color: var(--chicken); }
.admin__lead-obs-cliente { font-size: .84rem; color: var(--text); background: color-mix(in srgb, var(--bg-dark) 85%, white 15%); border-radius: 8px; padding: .8rem 1rem; margin: 0; white-space: pre-wrap; }
.admin__lead-recebido-full { font-size: .72rem; color: var(--muted); margin: 1rem 0 0; }

.admin__field select, .admin__field textarea { padding: .6rem .75rem; border-radius: 6px; border: 1px solid color-mix(in srgb, var(--fish) 35%, transparent); background: transparent; color: var(--cream); font: inherit; font-size: .9rem; }
.admin__field select { color-scheme: dark; }
.admin__field--full { grid-column: 1 / -1; }
.admin__lead-form { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; align-items: end; }
.admin__lead-form button { grid-column: span 1; justify-self: start; }
.admin__lead-form-msg { font-size: .8rem; align-self: center; }
@media (max-width: 560px) { .admin__lead-form { grid-template-columns: 1fr; } }
</style>
