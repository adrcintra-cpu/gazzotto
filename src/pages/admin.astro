---
import Layout from "../layouts/Layout.astro";
import { supabaseConfig } from "../data/media";
---
<Layout title="Painel | Gazzotto BBQ" description="Painel interno — leads e notificações." noindex>
  <main class="admin" id="admin-root">
    <!-- LOGIN -->
    <section class="admin__login" data-view="login">
      <form class="admin__login-card" data-login-form>
        <h1>Painel Gazzotto BBQ</h1>
        <p class="admin__hint">Entre com seu e-mail e senha de acesso.</p>
        <label class="admin__field">
          <span>E-mail</span>
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label class="admin__field">
          <span>Senha</span>
          <input type="password" name="senha" autocomplete="current-password" required />
        </label>
        <p class="admin__erro" data-login-erro hidden></p>
        <button type="submit" class="btn btn--red">Entrar</button>
        <button type="button" class="admin__link-btn" data-esqueci-abrir>Esqueceu a senha?</button>
      </form>

      <form class="admin__login-card admin__esqueci" data-esqueci-form hidden>
        <h1>Esqueci minha senha</h1>
        <p class="admin__hint">Informe seu e-mail de acesso. Vamos te mandar um link para criar uma senha nova.</p>
        <label class="admin__field">
          <span>E-mail</span>
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <p class="admin__erro" data-esqueci-msg hidden></p>
        <button type="submit" class="btn btn--red">Enviar link de redefinição</button>
        <button type="button" class="admin__link-btn" data-esqueci-cancelar>Voltar para o login</button>
      </form>
    </section>

    <!-- DEFINIR SENHA (primeiro acesso, via convite) -->
    <section class="admin__login" data-view="definir-senha" hidden>
      <form class="admin__login-card" data-senha-form>
        <h1>Defina sua senha</h1>
        <p class="admin__hint">Escolha uma senha de acesso definitiva para o painel Gazzotto BBQ.</p>
        <label class="admin__field">
          <span>Nova senha</span>
          <input type="password" name="senha" autocomplete="new-password" minlength="6" required />
        </label>
        <label class="admin__field">
          <span>Confirmar senha</span>
          <input type="password" name="confirmar" autocomplete="new-password" minlength="6" required />
        </label>
        <p class="admin__erro" data-senha-erro hidden></p>
        <button type="submit" class="btn btn--red">Definir senha e entrar</button>
      </form>
    </section>

    <!-- PAINEL -->
    <section class="admin__panel" data-view="panel" hidden>
      <header class="admin__bar">
        <h1>Painel Gazzotto BBQ</h1>
        <div class="admin__bar-actions">
          <span class="admin__user" data-usuario-logado></span>
          <button type="button" class="admin__btn-ghost" data-trocar-senha-abrir>Trocar senha</button>
          <button type="button" class="admin__btn-ghost" data-logout>Sair</button>
        </div>
      </header>

      <div class="admin__trocar-senha" data-trocar-senha-painel hidden>
        <form class="admin__add-contato" data-trocar-senha-form>
          <input type="password" name="senha" placeholder="Nova senha" autocomplete="new-password" minlength="6" required />
          <input type="password" name="confirmar" placeholder="Confirmar nova senha" autocomplete="new-password" minlength="6" required />
          <button type="submit" class="btn btn--red">Salvar nova senha</button>
          <button type="button" class="admin__btn-ghost" data-trocar-senha-cancelar>Cancelar</button>
        </form>
        <p class="admin__erro" data-trocar-senha-msg hidden></p>
      </div>

      <nav class="admin__tabs" aria-label="Seções do painel">
        <button type="button" class="admin__tab is-active" data-tab="leads">Leads</button>
        <button type="button" class="admin__tab" data-tab="notificacoes">Notificações WhatsApp</button>
        <button type="button" class="admin__tab" data-tab="colaboradores">Colaboradores</button>
      </nav>

      <div class="admin__view" data-tab-panel="leads">
        <div class="admin__toolbar">
          <h2>Pedidos recebidos</h2>
          <button type="button" class="admin__btn-ghost" data-reload-leads>Atualizar</button>
        </div>
        <div class="admin__table-wrap">
          <table class="admin__table" data-leads-table>
            <thead>
              <tr>
                <th>Protocolo</th><th>Responsável</th><th>WhatsApp</th><th>Experiência</th>
                <th>Evento</th><th>Data</th><th>Convidados</th><th>Status</th><th>Recebido em</th>
              </tr>
            </thead>
            <tbody data-leads-body>
              <tr><td colspan="9" class="admin__loading">Carregando…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="admin__view" data-tab-panel="notificacoes" hidden>
        <div class="admin__toolbar">
          <h2>Quem recebe o aviso de novo lead no WhatsApp</h2>
        </div>
        <p class="admin__hint">
          Cada novo pedido envia uma mensagem automática para os números ativos abaixo (via Z-API).
          Desative um contato sem precisar apagar, se for só uma pausa.
        </p>
        <form class="admin__add-contato" data-contato-form>
          <input type="text" name="nome" placeholder="Nome" required />
          <input type="tel" name="telefone" placeholder="Telefone (ex.: 5519991605930)" required />
          <button type="submit" class="btn btn--red">Adicionar</button>
        </form>
        <div class="admin__table-wrap">
          <table class="admin__table" data-contatos-table>
            <thead><tr><th>Nome</th><th>Telefone</th><th>Ativo</th><th></th></tr></thead>
            <tbody data-contatos-body>
              <tr><td colspan="4" class="admin__loading">Carregando…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="admin__view" data-tab-panel="colaboradores" hidden>
        <div class="admin__toolbar">
          <h2>Adicionar colaborador</h2>
        </div>
        <p class="admin__hint">
          Não depende de e-mail. Ao adicionar, geramos uma senha provisória aqui mesmo — copie e
          envie para a pessoa por WhatsApp (ou verbalmente). No primeiro acesso, ela é obrigada a
          trocar por uma senha própria, que ninguém mais vê ou define.
        </p>
        <form class="admin__add-contato" data-convite-form>
          <input type="email" name="email" placeholder="E-mail do colaborador" required />
          <button type="submit" class="btn btn--red">Adicionar e gerar senha</button>
        </form>
        <div class="admin__senha-gerada" data-senha-gerada hidden>
          <p>
            Colaborador <strong data-senha-gerada-email></strong> criado. Senha provisória:
            <code data-senha-gerada-valor></code>
            <button type="button" class="admin__btn-ghost admin__btn-small" data-copiar-senha>Copiar</button>
          </p>
          <p class="admin__hint">Envie essa senha por WhatsApp agora — ela só aparece aqui uma vez.</p>
        </div>
        <p class="admin__erro" data-convite-msg hidden></p>

        <div class="admin__toolbar" style="margin-top:2rem">
          <h2>Quem tem acesso</h2>
          <button type="button" class="admin__btn-ghost" data-reload-colaboradores>Atualizar</button>
        </div>
        <div class="admin__table-wrap">
          <table class="admin__table" data-colaboradores-table>
            <thead><tr><th>E-mail</th><th>Status</th><th>Último acesso</th><th></th></tr></thead>
            <tbody data-colaboradores-body>
              <tr><td colspan="4" class="admin__loading">Carregando…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="admin__erro" data-colaboradores-msg hidden></p>
      </div>
    </section>
  </main>
</Layout>

<script type="module" define:vars={{ SUPABASE_URL: supabaseConfig.url, SUPABASE_KEY: supabaseConfig.publishableKey }}>
  import { createClient } from "https://esm.sh/@supabase/supabase-js@2";
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  const root = document.getElementById("admin-root");
  const loginView = root.querySelector('[data-view="login"]');
  const senhaView = root.querySelector('[data-view="definir-senha"]');
  const panelView = root.querySelector('[data-view="panel"]');
  const loginForm = root.querySelector("[data-login-form]");
  const loginErro = root.querySelector("[data-login-erro]");
  const senhaForm = root.querySelector("[data-senha-form]");
  const senhaErro = root.querySelector("[data-senha-erro]");
  const esqueciForm = root.querySelector("[data-esqueci-form]");
  const esqueciMsg = root.querySelector("[data-esqueci-msg]");

  // Link de convite/recuperação da Supabase chega com "type=invite" (ou "type=recovery") no
  // hash da URL — nesse caso, antes de mostrar o painel, pedimos pra pessoa criar a própria senha.
  // O mesmo vale quando o colaborador foi criado com senha provisória (sem e-mail): o painel
  // marca user_metadata.precisa_trocar_senha=true nesse caso, e checamos isso a cada sessão.
  let aguardandoSenha = /type=invite|type=recovery/.test(window.location.hash);
  function precisaDefinirSenha(session) {
    return aguardandoSenha || !!session?.user?.user_metadata?.precisa_trocar_senha;
  }

  const MODALIDADE_LABELS = {
    pacote: "Cardápios Gazzotto",
    monte_cardapio: "Monte seu Cardápio",
    festival_hamburguer: "Festival de Hambúrguer",
  };

  let carregado = false;

  function mostrarLogin() {
    panelView.hidden = true;
    senhaView.hidden = true;
    loginView.hidden = false;
    esqueciForm.hidden = true;
    loginForm.hidden = false;
    carregado = false;
  }

  function mostrarDefinirSenha() {
    panelView.hidden = true;
    loginView.hidden = true;
    senhaView.hidden = false;
  }

  let meuUserId = null;

  function mostrarPainel(email, userId) {
    loginView.hidden = true;
    senhaView.hidden = true;
    panelView.hidden = false;
    root.querySelector("[data-usuario-logado]").textContent = email || "";
    if (userId) meuUserId = userId;
    if (!carregado) {
      carregado = true;
      carregarLeads();
      carregarContatos();
      carregarColaboradores();
    }
  }

  // ---------- Sessão ----------
  async function verificarSessao() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session && precisaDefinirSenha(session)) mostrarDefinirSenha();
    else if (session) mostrarPainel(session.user.email, session.user.id);
    else mostrarLogin();
  }
  verificarSessao();

  supabase.auth.onAuthStateChange((_evento, session) => {
    if (session && precisaDefinirSenha(session)) mostrarDefinirSenha();
    else if (session) mostrarPainel(session.user.email, session.user.id);
    else mostrarLogin();
  });

  senhaForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    senhaErro.hidden = true;
    const fd = new FormData(senhaForm);
    const senha = fd.get("senha");
    if (senha !== fd.get("confirmar")) {
      senhaErro.textContent = "As senhas não são iguais.";
      senhaErro.hidden = false;
      return;
    }
    // data: {...} também limpa a flag de senha provisória (metadata do próprio usuário —
    // não precisa de service role, qualquer sessão pode atualizar seus próprios metadados).
    const { data, error } = await supabase.auth.updateUser({ password: senha, data: { precisa_trocar_senha: false } });
    if (error) {
      senhaErro.textContent = "Não foi possível definir a senha: " + error.message;
      senhaErro.hidden = false;
      return;
    }
    aguardandoSenha = false;
    history.replaceState(null, "", window.location.pathname);
    senhaForm.reset();
    mostrarPainel(data.user?.email, data.user?.id);
  });

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    loginErro.hidden = true;
    const fd = new FormData(loginForm);
    const { data, error } = await supabase.auth.signInWithPassword({
      email: fd.get("email"),
      password: fd.get("senha"),
    });
    if (error) {
      loginErro.textContent = "E-mail ou senha incorretos.";
      loginErro.hidden = false;
      return;
    }
    loginForm.reset();
    // Mostra o painel na hora, sem depender só do onAuthStateChange (no Safari esse aviso
    // às vezes demora/não dispara a tempo, e a tela ficava voltando pro login em branco).
    // Colaborador com senha provisória (primeiro login) cai na tela de definir senha, não no painel.
    if (precisaDefinirSenha(data.session)) mostrarDefinirSenha();
    else mostrarPainel(data.user?.email, data.user?.id);
  });

  // ---------- Esqueci minha senha ----------
  root.querySelector("[data-esqueci-abrir]").addEventListener("click", () => {
    loginForm.hidden = true;
    esqueciMsg.hidden = true;
    esqueciForm.reset();
    esqueciForm.hidden = false;
  });
  root.querySelector("[data-esqueci-cancelar]").addEventListener("click", () => {
    esqueciForm.hidden = true;
    esqueciMsg.hidden = true;
    esqueciForm.reset();
    loginForm.hidden = false;
  });
  esqueciForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    esqueciMsg.hidden = true;
    const email = new FormData(esqueciForm).get("email");
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: window.location.origin + "/",
    });
    if (error) {
      esqueciMsg.textContent = "Não foi possível enviar o link: " + error.message;
      esqueciMsg.style.color = "var(--burger)";
    } else {
      esqueciMsg.textContent = "Se esse e-mail tiver cadastro, um link de redefinição foi enviado agora.";
      esqueciMsg.style.color = "var(--chicken)";
    }
    esqueciMsg.hidden = false;
  });

  root.querySelector("[data-logout]").addEventListener("click", async () => {
    await supabase.auth.signOut();
  });

  // ---------- Trocar senha (usuário já logado) ----------
  const trocarSenhaPainel = root.querySelector("[data-trocar-senha-painel]");
  const trocarSenhaForm = root.querySelector("[data-trocar-senha-form]");
  const trocarSenhaMsg = root.querySelector("[data-trocar-senha-msg]");

  root.querySelector("[data-trocar-senha-abrir]").addEventListener("click", () => {
    trocarSenhaPainel.hidden = !trocarSenhaPainel.hidden;
  });
  root.querySelector("[data-trocar-senha-cancelar]").addEventListener("click", () => {
    trocarSenhaForm.reset();
    trocarSenhaMsg.hidden = true;
    trocarSenhaPainel.hidden = true;
  });
  trocarSenhaForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    trocarSenhaMsg.hidden = true;
    const fd = new FormData(trocarSenhaForm);
    const senha = fd.get("senha");
    if (senha !== fd.get("confirmar")) {
      trocarSenhaMsg.textContent = "As senhas não são iguais.";
      trocarSenhaMsg.style.color = "var(--burger)";
      trocarSenhaMsg.hidden = false;
      return;
    }
    const { error } = await supabase.auth.updateUser({ password: senha });
    trocarSenhaForm.reset();
    if (error) {
      trocarSenhaMsg.textContent = "Não foi possível trocar a senha: " + error.message;
      trocarSenhaMsg.style.color = "var(--burger)";
    } else {
      trocarSenhaMsg.textContent = "Senha atualizada com sucesso.";
      trocarSenhaMsg.style.color = "var(--chicken)";
    }
    trocarSenhaMsg.hidden = false;
  });

  // ---------- Abas ----------
  root.querySelectorAll("[data-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      root.querySelectorAll("[data-tab]").forEach((t) => t.classList.toggle("is-active", t === tab));
      root.querySelectorAll("[data-tab-panel]").forEach((p) => { p.hidden = p.dataset.tabPanel !== tab.dataset.tab; });
    });
  });

  // ---------- Leads ----------
  async function carregarLeads() {
    const body = root.querySelector("[data-leads-body]");
    body.innerHTML = '<tr><td colspan="9" class="admin__loading">Carregando…</td></tr>';
    const { data, error } = await supabase
      .from("orcamentos")
      .select("protocolo, nome_responsavel, whatsapp, modalidade, tipo_evento, data_evento, qtd_adultos, qtd_criancas, status, created_at")
      .order("created_at", { ascending: false });
    if (error) {
      body.innerHTML = '<tr><td colspan="9" class="admin__erro-cel">Erro ao carregar: ' + error.message + "</td></tr>";
      return;
    }
    if (!data.length) {
      body.innerHTML = '<tr><td colspan="9" class="admin__loading">Nenhum pedido recebido ainda.</td></tr>';
      return;
    }
    body.innerHTML = data.map((o) => `
      <tr>
        <td>${o.protocolo}</td>
        <td>${o.nome_responsavel}</td>
        <td><a href="https://wa.me/${o.whatsapp}" target="_blank" rel="noopener">${o.whatsapp}</a></td>
        <td>${MODALIDADE_LABELS[o.modalidade] || o.modalidade}</td>
        <td>${o.tipo_evento || "-"}</td>
        <td>${o.data_evento ? new Date(o.data_evento + "T00:00:00").toLocaleDateString("pt-BR") : "-"}</td>
        <td>${o.qtd_adultos || 0}${o.qtd_criancas ? " + " + o.qtd_criancas + "c" : ""}</td>
        <td><span class="admin__status">${o.status}</span></td>
        <td>${new Date(o.created_at).toLocaleString("pt-BR")}</td>
      </tr>
    `).join("");
  }
  root.querySelector("[data-reload-leads]").addEventListener("click", carregarLeads);

  // ---------- Notificações ----------
  async function carregarContatos() {
    const body = root.querySelector("[data-contatos-body]");
    body.innerHTML = '<tr><td colspan="4" class="admin__loading">Carregando…</td></tr>';
    const { data, error } = await supabase
      .from("notificacao_contatos")
      .select("id, nome, telefone, ativo")
      .order("criado_em", { ascending: true });
    if (error) {
      body.innerHTML = '<tr><td colspan="4" class="admin__erro-cel">Erro ao carregar: ' + error.message + "</td></tr>";
      return;
    }
    if (!data.length) {
      body.innerHTML = '<tr><td colspan="4" class="admin__loading">Nenhum contato cadastrado.</td></tr>';
      return;
    }
    body.innerHTML = data.map((c) => `
      <tr data-contato-row="${c.id}">
        <td>${c.nome}</td>
        <td>${c.telefone}</td>
        <td>
          <label class="admin__switch">
            <input type="checkbox" data-toggle-ativo="${c.id}" ${c.ativo ? "checked" : ""} />
            <span>${c.ativo ? "Ativo" : "Pausado"}</span>
          </label>
        </td>
        <td><button type="button" class="admin__btn-ghost admin__btn-small" data-remover="${c.id}">Remover</button></td>
      </tr>
    `).join("");

    body.querySelectorAll("[data-toggle-ativo]").forEach((input) => {
      input.addEventListener("change", async (e) => {
        const id = e.target.dataset.toggleAtivo;
        await supabase.from("notificacao_contatos").update({ ativo: e.target.checked }).eq("id", id);
        carregarContatos();
      });
    });
    body.querySelectorAll("[data-remover]").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = e.target.dataset.remover;
        if (!confirm("Remover este contato de notificação?")) return;
        await supabase.from("notificacao_contatos").delete().eq("id", id);
        carregarContatos();
      });
    });
  }

  root.querySelector("[data-contato-form]").addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);
    const telefone = fd.get("telefone").toString().replace(/\D/g, "");
    await supabase.from("notificacao_contatos").insert({ nome: fd.get("nome"), telefone, ativo: true });
    form.reset();
    carregarContatos();
  });

  // ---------- Convidar colaborador ----------
  const conviteMsg = root.querySelector("[data-convite-msg]");
  const senhaGeradaBox = root.querySelector("[data-senha-gerada]");
  root.querySelector("[data-convite-form]").addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target;
    conviteMsg.hidden = true;
    senhaGeradaBox.hidden = true;
    const fd = new FormData(form);
    const email = fd.get("email");
    const { data: { session } } = await supabase.auth.getSession();
    try {
      const resp = await fetch(`${SUPABASE_URL}/functions/v1/colaboradores`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${session.access_token}`,
          apikey: SUPABASE_KEY,
        },
        body: JSON.stringify({ action: "criar", email }),
      });
      const resultado = await resp.json();
      if (!resp.ok || !resultado.ok) throw new Error(resultado.error || "falha ao adicionar colaborador");
      senhaGeradaBox.querySelector("[data-senha-gerada-email]").textContent = resultado.email;
      senhaGeradaBox.querySelector("[data-senha-gerada-valor]").textContent = resultado.senha_provisoria;
      senhaGeradaBox.hidden = false;
      form.reset();
      carregarColaboradores();
    } catch (err) {
      conviteMsg.textContent = "Não foi possível adicionar o colaborador: " + err.message;
      conviteMsg.style.color = "var(--burger)";
      conviteMsg.hidden = false;
    }
  });

  senhaGeradaBox.querySelector("[data-copiar-senha]").addEventListener("click", async (e) => {
    const senha = senhaGeradaBox.querySelector("[data-senha-gerada-valor]").textContent;
    try {
      await navigator.clipboard.writeText(senha);
      const original = e.target.textContent;
      e.target.textContent = "Copiado!";
      setTimeout(() => { e.target.textContent = original; }, 1500);
    } catch {
      // clipboard indisponível (ex.: contexto não seguro) -- a senha já está visível na tela.
    }
  });

  // ---------- Quem tem acesso (listar/excluir) ----------
  const colaboradoresMsg = root.querySelector("[data-colaboradores-msg]");

  async function carregarColaboradores() {
    const body = root.querySelector("[data-colaboradores-body]");
    body.innerHTML = '<tr><td colspan="4" class="admin__loading">Carregando…</td></tr>';
    colaboradoresMsg.hidden = true;
    const { data: { session } } = await supabase.auth.getSession();
    try {
      const resp = await fetch(`${SUPABASE_URL}/functions/v1/colaboradores`, {
        method: "GET",
        headers: { Authorization: `Bearer ${session.access_token}`, apikey: SUPABASE_KEY },
      });
      const resultado = await resp.json();
      if (!resp.ok || !resultado.ok) throw new Error(resultado.error || "falha ao carregar colaboradores");
      const lista = resultado.colaboradores || [];
      if (!lista.length) {
        body.innerHTML = '<tr><td colspan="4" class="admin__loading">Nenhum colaborador encontrado.</td></tr>';
        return;
      }
      body.innerHTML = lista.map((c) => {
        const souEu = c.id === meuUserId;
        const status = c.precisa_trocar_senha ? "Senha provisória" : (c.confirmado ? "Ativo" : "Convite pendente");
        return `
        <tr data-colaborador-row="${c.id}">
          <td>${c.email}${souEu ? " (você)" : ""}</td>
          <td>${status}</td>
          <td>${c.ultimo_acesso ? new Date(c.ultimo_acesso).toLocaleString("pt-BR") : "nunca acessou"}</td>
          <td>${souEu ? "" : `<button type="button" class="admin__btn-ghost admin__btn-small" data-excluir-colaborador="${c.id}">Excluir</button>`}</td>
        </tr>
      `;
      }).join("");

      body.querySelectorAll("[data-excluir-colaborador]").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          const id = e.target.dataset.excluirColaborador;
          const email = e.target.closest("tr").querySelector("td").textContent;
          if (!confirm(`Remover o acesso de ${email} ao painel? Essa ação não pode ser desfeita.`)) return;
          colaboradoresMsg.hidden = true;
          try {
            const resp = await fetch(`${SUPABASE_URL}/functions/v1/colaboradores`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${session.access_token}`,
                apikey: SUPABASE_KEY,
              },
              body: JSON.stringify({ action: "excluir", id }),
            });
            const resultado = await resp.json();
            if (!resp.ok || !resultado.ok) throw new Error(resultado.error || "falha ao excluir");
            carregarColaboradores();
          } catch (err) {
            colaboradoresMsg.textContent = "Não foi possível excluir: " + err.message;
            colaboradoresMsg.style.color = "var(--burger)";
            colaboradoresMsg.hidden = false;
          }
        });
      });
    } catch (err) {
      body.innerHTML = '<tr><td colspan="4" class="admin__erro-cel">Erro ao carregar: ' + err.message + "</td></tr>";
    }
  }
  root.querySelector("[data-reload-colaboradores]").addEventListener("click", carregarColaboradores);
</script>

